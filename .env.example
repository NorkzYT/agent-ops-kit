# agent-ops-kit — one env file for the whole stack.
#   cp .env.example .env   (or just `make init`, which also generates the secrets)
# Secrets are read by docker compose, scripts/hermes-install.sh and scripts/doctor.sh.

# ---------------------------------------------------------------- Network ---
# Address the containers and the Claude proxy listen on. 127.0.0.1 = this
# machine only (default). Set 0.0.0.0 (or the Tailscale IP) only when the
# Windows VM worker must reach the proxies and Honcho, and put a firewall or
# Tailscale in front of it.
BIND_ADDR=127.0.0.1
# Where your repositories live. Hermes' terminal starts here and so does every
# Claude Code session the proxy spawns (its systemd WorkingDirectory).
REPOS_DIR=/opt/repos

# ------------------------------------------------- ChatGPT / Codex proxy ---
# CLIProxyAPI turns your ChatGPT subscription (Codex OAuth) into an
# OpenAI-compatible API on :8317. Log in once with `make auth-codex`.
CLIPROXY_PORT=8317
# Client key every consumer sends (Hermes, Honcho, Windows worker). `make init`
# fills these two in with random values when empty.
CLIPROXY_API_KEY=
CLIPROXY_MANAGEMENT_KEY=
# CLIPROXY_IMAGE=eceasy/cli-proxy-api:latest

# ------------------------------------------------------ Claude Max proxy ---
# claude-max-api-proxy turns your Claude Max subscription into an
# OpenAI-compatible API on :3456. Hermes sends coding work here. It runs ON
# THE HOST as a systemd user service (make claude-proxy-install), not in
# Docker: the Claude Code sessions it spawns then see your repos, toolchains
# (go, node, uv, ...), docker and gh exactly as you do, and survive rebuilds.
CLAUDE_MAX_PROXY_PORT=3456
# Long-lived OAuth token (about a year). `make auth-claude-proxy` runs the login
# and stores it here. Until it is set the service idles instead of serving.
CLAUDE_CODE_OAUTH_TOKEN=
# Sources are vendored in this repo (vendor/claude-max-api-proxy, pinned in its
# UPSTREAM file) and built with npm by `make claude-proxy-install`.
# `make claude-proxy-update` refreshes them from upstream when it is reachable
# and keeps the vendored copy when it is not. Override the source only if you
# maintain a fork.
# CLAUDE_MAX_PROXY_DIR=./vendor/claude-max-api-proxy
# CLAUDE_MAX_PROXY_REPO=https://github.com/mattschwen/claude-max-api-proxy.git
# CLAUDE_MAX_PROXY_REF=main
# Extended-thinking budget applied when a client sends none: off|low|medium|high|xhigh|max
DEFAULT_THINKING_BUDGET=high
# Claude Code sessions the proxy runs at the same time (Hermes subagents).
# Each one is a full CLI session plus whatever it spawns (builds, tests):
# budget ~1 core and ~4 GB each, and all of them share the Claude Max 5-hour
# window. Extra requests queue, they do not fail. Size the three limits below
# together: CPUS ~ 1.3 x sessions, MEM ~ 4G x sessions.
#   laptop / 4-core VM ....... 2 sessions, CPUS=3,  MEM_LIMIT=8G
#   8-core / 32 GB ........... 3 sessions, CPUS=4,  MEM_LIMIT=12G   (defaults)
#   16-core / 128 GB shared .. 6 sessions, CPUS=8,  MEM_LIMIT=24G
CLAUDE_PROXY_MAX_CONCURRENT_REQUESTS=3
# systemd cgroup limits for the proxy AND every Claude Code session/tool it
# spawns (CPUQuota, MemoryMax, TasksMax). This is what keeps a runaway session
# from freezing the host. Fractions are fine (2.5). Memory takes K/M/G.
CLAUDE_MAX_PROXY_CPUS=4
CLAUDE_MAX_PROXY_MEM_LIMIT=12G
CLAUDE_MAX_PROXY_TASKS_MAX=4096
# Restart the proxy after N hours of uptime, once no request is active or
# queued, so leaked CLI subprocesses and stale OAuth state are cleared.
# systemd brings it straight back. Empty or 0 disables.
CLAUDE_PROXY_MAX_UPTIME_HOURS=12

# ------------------------------------------------------------------ Honcho ---
# Self-hosted Honcho (API + deriver + Postgres/pgvector + Redis).
HONCHO_PORT=8000
# Postgres password for honcho-db. `make init` generates it. Postgres only
# applies it when the data volume is first created (docs/troubleshooting.md).
HONCHO_DB_PASSWORD=
# Model Honcho's reasoning layer uses. Routed through CLIProxyAPI, so this must
# be a model your ChatGPT subscription exposes. Check with `make models`.
# The deriver makes many small calls per chat turn; a mid tier (Terra-class)
# is plenty here and spares the ChatGPT quota for the orchestrator.
HONCHO_MODEL=gpt-5.5
# Local embedding model served by Ollama (no API key). Dimensions must match
# the model: nomic-embed-text=768 (8k context, 274 MB, the default),
# bge-m3=1024 (8k context, multilingual, 1.2 GB), mxbai-embed-large=1024
# (512-token context: truncates Honcho's longer documents, not recommended).
# Honcho creates its vector columns at 1536; the kit's honcho-api entrypoint
# resizes them to this value on an EMPTY database. Changing it later = make clean.
HONCHO_EMBED_MODEL=nomic-embed-text
HONCHO_EMBED_DIMENSIONS=768
# json_schema (default) or json_object — switch if the deriver logs
# "response_format" errors from the proxy.
HONCHO_STRUCTURED_OUTPUT_MODE=json_schema
HONCHO_LOG_LEVEL=INFO
# Identity inside Honcho. HONCHO_PEER_NAME is the peer that represents YOU:
# Honcho builds its model of the user under this name and every profile and
# the Windows worker read it, so they share what they learn about you. Any
# short id works (`me`, `norkz`). Set it before the first `make hermes-install`;
# changing it later starts a new peer with empty memory. HONCHO_WORKSPACE
# scopes all peers and sessions; one workspace per operator.
HONCHO_PEER_NAME=me
HONCHO_WORKSPACE=agent-ops
# OLLAMA_CPUS=2.0
# OLLAMA_MEM_LIMIT=3g
# OLLAMA_KEEP_ALIVE=24h

# ------------------------------------------------------------------ Hermes ---
# Primary model for the orchestrator (ChatGPT subscription via CLIProxyAPI).
# Use an id from `make models`. In the GPT-5.6 line `gpt-5.6` is OpenAI's
# alias for `gpt-5.6-sol` (flagship); `gpt-5.6-terra` is the mid tier.
HERMES_MODEL=gpt-5.5
# Model for delegated coding subagents (Claude Max via claude-max-proxy).
# `opus`, `sonnet`, `haiku`, `default`, or an exact id from `make models`
# (for example the Fable id your account exposes).
HERMES_CODING_MODEL=opus
# Where Hermes keeps everything: config.yaml, .env, honcho.json, SOUL.md,
# memories/, skills/, sessions, cron jobs, its venv and profiles/<name>.
# Default is ~/.hermes; set this only to put it somewhere else (all kit
# scripts and the systemd unit read it).
# HERMES_HOME=/home/you/.hermes

# ----------------------------------------------------------------- Discord ---
# Bot token from https://discord.com/developers/applications (Bot -> Reset Token).
# Enable "Message Content Intent" and "Server Members Intent" on the bot.
DISCORD_BOT_TOKEN=
# Comma-separated Discord user ids allowed to talk to the bot (Developer Mode ->
# right-click your name -> Copy User ID). Leave empty = nobody (safe default).
DISCORD_ALLOWED_USERS=
# Channel id for proactive messages (cron results, kanban updates).
DISCORD_HOME_CHANNEL=
# Comma-separated channel ids where the bot answers without an @mention.
DISCORD_FREE_RESPONSE_CHANNELS=

# ------------------------------------------------------------- Browser Use ---
# Optional. Empty = Hermes drives a local Chromium through the Browser Use CLI.
# Set a key from https://browser-use.com to use Browser Use Cloud instead
# (managed Chromium, stealth, residential proxies).
BROWSER_USE_API_KEY=

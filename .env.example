# agent-ops-kit — one env file for the whole stack.
#   cp .env.example .env   (or just `make init`, which also generates the secrets)
# Secrets are read by docker compose, scripts/hermes-install.sh and scripts/doctor.sh.

# ---------------------------------------------------------------- Network ---
# Address the containers publish on. 127.0.0.1 = this machine only (default).
# Set 0.0.0.0 only when the Windows VM worker must reach the proxies and Honcho,
# and put a firewall or Tailscale in front of it.
BIND_ADDR=127.0.0.1
# Repositories the coding worker may operate on (mounted read/write).
REPOS_DIR=/opt/repos
# User the claude-max-proxy container runs as; must own REPOS_DIR and
# data/claude-max-proxy. Left empty, `make init` fills in `id -u` / `id -g`.
PUID=
PGID=

# ------------------------------------------------- ChatGPT / Codex proxy ---
# CLIProxyAPI turns your ChatGPT subscription (Codex OAuth) into an
# OpenAI-compatible API on :8317. Log in once with `make auth-codex`.
CLIPROXY_PORT=8317
# Client key every consumer sends (Hermes, Honcho, Windows worker). `make init`
# fills these two in with random values when empty.
CLIPROXY_API_KEY=
CLIPROXY_MANAGEMENT_KEY=
# CLIPROXY_IMAGE=eceasy/cli-proxy-api:latest

# ------------------------------------------------------ Claude Max proxy ---
# claude-max-api-proxy turns your Claude Max subscription into an
# OpenAI-compatible API on :3456. Hermes sends coding work here.
CLAUDE_MAX_PROXY_PORT=3456
# Long-lived OAuth token (about a year). `make auth-claude-proxy` runs the login
# and stores it here. Until it is set the container idles instead of serving.
CLAUDE_CODE_OAUTH_TOKEN=
# Source checkout used to build the proxy image (synced by `make init` / `make update`).
# CLAUDE_MAX_PROXY_DIR=./vendor/claude-max-api-proxy
# CLAUDE_MAX_PROXY_REPO=https://github.com/NorkzYT/claude-max-api-proxy.git
# CLAUDE_MAX_PROXY_REF=main
# Extended-thinking budget applied when a client sends none: off|low|medium|high|xhigh|max
DEFAULT_THINKING_BUDGET=high
CLAUDE_PROXY_MAX_CONCURRENT_REQUESTS=2
CLAUDE_PROXY_MAX_UPTIME_HOURS=4
# CLAUDE_MAX_PROXY_CPUS=2.0
# CLAUDE_MAX_PROXY_MEM_LIMIT=8g

# ------------------------------------------------------------------ Honcho ---
# Self-hosted Honcho (API + deriver + Postgres/pgvector + Redis).
HONCHO_PORT=8000
# Model Honcho's reasoning layer uses. Routed through CLIProxyAPI, so this must
# be a model your ChatGPT subscription exposes. Check with `make models`.
HONCHO_MODEL=gpt-5.5
# Local embedding model served by Ollama (no API key). Dimensions must match
# the model: nomic-embed-text=768, mxbai-embed-large=1024, all-minilm=384.
# Honcho creates its vector columns at 1536; the kit's honcho-api entrypoint
# resizes them to this value on an EMPTY database. Changing it later = make clean.
HONCHO_EMBED_MODEL=nomic-embed-text
HONCHO_EMBED_DIMENSIONS=768
# json_schema (default) or json_object — switch if the deriver logs
# "response_format" errors from the proxy.
HONCHO_STRUCTURED_OUTPUT_MODE=json_schema
HONCHO_LOG_LEVEL=INFO
# Identity Hermes uses inside Honcho. peer name = you; workspace = shared env.
HONCHO_PEER_NAME=me
HONCHO_WORKSPACE=agent-ops
# OLLAMA_CPUS=2.0
# OLLAMA_MEM_LIMIT=3g
# OLLAMA_KEEP_ALIVE=24h

# ------------------------------------------------------------------ Hermes ---
# Primary model for the orchestrator (ChatGPT subscription via CLIProxyAPI).
HERMES_MODEL=gpt-5.5
# Model for delegated coding subagents (Claude Max via claude-max-proxy).
# `opus`, `sonnet`, `haiku`, `default`, or an exact id from `make models`
# (for example the Fable id your account exposes).
HERMES_CODING_MODEL=opus
# Hermes home; profiles live under $HERMES_HOME/profiles/<name>.
# HERMES_HOME=/home/you/.hermes

# ----------------------------------------------------------------- Discord ---
# Bot token from https://discord.com/developers/applications (Bot -> Reset Token).
# Enable "Message Content Intent" and "Server Members Intent" on the bot.
DISCORD_BOT_TOKEN=
# Comma-separated Discord user ids allowed to talk to the bot (Developer Mode ->
# right-click your name -> Copy User ID). Leave empty = nobody (safe default).
DISCORD_ALLOWED_USERS=
# Channel id for proactive messages (cron results, kanban updates).
DISCORD_HOME_CHANNEL=
# Comma-separated channel ids where the bot answers without an @mention.
DISCORD_FREE_RESPONSE_CHANNELS=

# ------------------------------------------------------------- Browser Use ---
# Optional. Empty = Hermes drives a local Chromium through the Browser Use CLI.
# Set a key from https://browser-use.com to use Browser Use Cloud instead
# (managed Chromium, stealth, residential proxies).
BROWSER_USE_API_KEY=

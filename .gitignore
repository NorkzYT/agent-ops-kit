*logs

# Session state (three-file pattern) - local working memory
# Keep templates, ignore actual session directories
.claude/context/*
!.claude/context/templates/
!.claude/context/.gitkeep

# Python bytecode (created when hooks run)
__pycache__/
*.pyc

# Vendored external repos (cloned by .claude/extras/install-extras.sh)
.claude/vendor/

# Synced commands from wshobson/commands (keep these out of git)
.claude/commands/tools/
.claude/commands/workflows/

# Synced skills from external repos
.claude/skills/wshobson-*

# Ephemeral local state files
.claude/checkpoint-state.local.json
.claude/ralph-loop.local.md
.claude/terminal-identity.local.json

# Local environment files
.env
.env.local
.env.*.local

# Note: .claude/settings.local.json IS tracked in this repo (it's part of the bundle)
# Users may override with their own settings after installation

tmp

# Local Codex runtime state
.codex/
.codex-home/
.agents/

# Local agent runtime state and identity files (never commit).
# NOTE: this is the kit's SOURCE repo — .claude/, AGENTS.md and hermes/ are
# tracked content here and must never be ignored. The installer-appended block
# (which does ignore .claude/) is for target repos only; install.sh skips it here.
.hermes/
# Leftovers from the previous OpenClaw/CrewAI setup on older checkouts; safe to delete.
.openclaw/
.crewai/
SOUL.md
# ...but hermes/ is this kit's tracked source (see note above): keep its SOUL prompts.
!hermes/SOUL.md
!hermes/profiles/*/SOUL.md
USER.md
IDENTITY.md
TOOLS.md
HEARTBEAT.md
BOOTSTRAP.md
MEMORY.md
memory/
PROJECT.md

# Eval harness run outputs (keep the dir, ignore generated results)
.claude/eval/results/*
!.claude/eval/results/.gitkeep

# Stack runtime (rendered configs, OAuth state, docker data)
data/
# vendor/claude-max-api-proxy is committed (see its UPSTREAM file); only its
# build output and local state stay out.
vendor/claude-max-api-proxy/node_modules/
vendor/claude-max-api-proxy/dist/
vendor/claude-max-api-proxy/.agent-ops-kit-built
vendor/claude-max-api-proxy/.env

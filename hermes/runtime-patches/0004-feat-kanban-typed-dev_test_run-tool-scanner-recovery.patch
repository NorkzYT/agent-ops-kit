+def test_handler_runs_the_verified_runner_with_an_empty_environment(attested_backend, headless, registry_file, worker_env):
+    calls = []
+
+    def fake_runner(argv, **kw):
+        calls.append((argv, kw))
+        out = {"ok": True, "exit_code": 0, "tests": {"passed": 3, "failed": 0, "skipped": 1},
+               "skipped_tests": [{"test": "TestX", "reason": "fixture"}],
+               "build_output": f"postgres://postgres:{CANARY}@127.0.0.1:55432/example_test"}
+        return subprocess.CompletedProcess(argv, 0, json.dumps(out), "")
+
+    dtt.recovery_hint(SCANNER_BLOCKED_CMD)
+    result = json.loads(dtt.dev_test_run({"profile": "example-service"}, runner=fake_runner))
+    assert dtt.block_refusal() is None, "an attempt clears the pending recovery"
+    argv, kw = calls[0]
+    assert argv[:5] == ["/usr/bin/python3", "-I", "-S", str(registry_file["helper"]), "run"]
+    assert ["--task", "t_12345678", "--run-id", "77"] == argv[5:9]
+    assert kw["env"] == {"PATH": "/usr/bin:/bin", "LANG": "C.UTF-8"}
+    assert result["tests"] == {"passed": 3, "failed": 0, "skipped": 1}
+    assert CANARY not in json.dumps(result)

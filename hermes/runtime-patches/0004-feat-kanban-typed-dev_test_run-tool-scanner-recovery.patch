+"""``dev_test_run``: registered Go/PostgreSQL development tests for Kanban coding workers.
+
+A typed tool instead of a terminal allowlist. The operator registers test profiles in a
+root-owned file (``/usr/local/etc/hermes-devtest/profiles.json``) installed together with a
+root-owned trusted runner whose SHA-256 the file pins (agent-ops-kit
+``scripts/install-hermes-devtest.sh``). On every call this tool:
+
+1. validates the typed arguments (profile name, approved package patterns, a test-name regex,
+   race/short/vet booleans, a bounded timeout); go flags cannot be expressed at all;
+2. requires the dispatcher-owned worker context (``HERMES_KANBAN_TASK``/``RUN_ID``; never a
+   delegate child or a cron run) and passes task and run to the runner, which re-checks them
+   against the board (this process must be the worker pid of the running claim) and the
+   repository lease of the profile's checkout;
+3. re-verifies the profile file and the runner (owner root, no group/other write, no
+   symlink, root-owned parent directories, digest equal to the pinned one) and fails closed
+   on any difference;
+4. scans the exact fixed invocation through the normal command guards (hardline floor,
+   dangerous patterns, Tirith); nothing is filtered or allowlisted;
+5. runs it with an empty environment and returns the runner's JSON (exit code, test, skip
+   and package counts, failing-test output), redacted again.
+
+Isolation: every profile must declare ``isolation.mode``. ``credential-broker-netns`` is the
+only mode this module recognises as a *proposed* acceptable design; any other mode (including
+the current ``same-uid-landlock``) is a rejected design. A recognised mode string is syntactic
+config validity only. Runnable readiness additionally needs an implemented, provisioned and
+attested backend for that mode (``backend_attested``); no such backend exists in this runtime,
+so ``runnable_profiles`` is empty, the tool is hidden, ``dev_test_run`` refuses before
+anything runs and no ``RECOVERY:`` directive is ever produced, regardless of what a root-owned
+registry declares. A future implementation must probe the trusted broker (identity, liveness,
+schema, capability) there; it must not be a string comparison, an environment variable or a
+boolean. The same-UID design was rejected in review: it does not meet the network or
+credential isolation requirements (tests running as the worker's uid can reach the network
+and the credential file). This module makes no claim that any design is sound; see
+``docs/dev-test-runner.md`` in agent-ops-kit.
+
+The credential and database-target guards are additive and must never depend on runnable
+readiness: they read the trusted registry leniently (``guard_registry``), so an older trusted
+profile file without ``isolation.mode`` still blocks credential reads.
+
+The module also carries the scanner-recovery state, per worker (task, run): a terminal command
+the unattended gate rejects that has an approved registered equivalent gets a recovery
+directive naming this tool, and ``kanban_block`` refuses until that equivalent was started or
+refused for a precondition outside the worker's control.
+"""
+
+from __future__ import annotations
+
+import hashlib
+import hmac
+import json
+import logging
+import os
+import re
+import shlex
+import stat
+import subprocess
+import threading
+import time
+from typing import Optional
+
+from tools.registry import no_cache_check_fn, registry, tool_error
+
+logger = logging.getLogger(__name__)
+
+CONFIG_PATH = "/usr/local/etc/hermes-devtest/profiles.json"
+TRUSTED_UID = 0
+TOOL_NAME = "dev_test_run"
+TIMEOUT_MIN, TIMEOUT_MAX, TIMEOUT_DEFAULT = 60, 3600, 1200
+RUNNER_GRACE = 300
+VET_BUDGET = 600
+APPROVED_ISOLATION_MODE = "credential-broker-netns"  # proposed design; recognised string, nothing more
+ISOLATION_REFUSAL = ("rejected isolation design; operator approval and privileged provisioning required, "
+                     "see docs/dev-test-runner.md in agent-ops-kit")
+NOT_IMPLEMENTED_REFUSAL = ("the proposed isolation design is recognised but no implemented, provisioned and "
+                           "attested backend exists in this runtime (a registry declaring the mode is config "
+                           "validity, not readiness); operator approval and privileged provisioning required, "
+                           "see docs/dev-test-runner.md in agent-ops-kit")
+PROFILE_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,47}$")
+PACKAGE_RE = re.compile(r"^\./(?:[A-Za-z0-9_][A-Za-z0-9_.-]*/)*(?:[A-Za-z0-9_][A-Za-z0-9_.-]*|\.\.\.)$")
+RUN_FILTER_RE = re.compile(r"^[A-Za-z0-9_^$|()./*+?\[\]-]{1,256}$")
+_ARG_KEYS = {"profile", "packages", "run", "race", "short", "vet", "timeout_seconds"}
+
+
+class DevTestRefused(Exception):
+    """Fail-closed refusal; the message is shown to the model verbatim."""
+
+
+# ------------------------------------------------------------------ trust ---
+
+def _check_trusted(path: str, trusted_uid: int, what: str, *, executable: bool = False) -> None:
+    if not isinstance(path, str) or not os.path.isabs(path) or os.path.normpath(path) != path:
+        raise DevTestRefused(f"{what} path {path!r} is not absolute and normalized")
+    try:
+        st = os.lstat(path)
+    except FileNotFoundError:
+        raise DevTestRefused(f"{what} {path} is not installed")
+    if stat.S_ISLNK(st.st_mode) or not stat.S_ISREG(st.st_mode):
+        raise DevTestRefused(f"{what} {path} is not a regular file (symlinks are refused)")
+    if st.st_uid != trusted_uid or st.st_mode & 0o022:
+        raise DevTestRefused(f"{what} {path} must be owned by uid {trusted_uid} and not group/other writable "
+                             f"(found uid {st.st_uid}, mode {oct(st.st_mode & 0o777)})")
+    if executable and not st.st_mode & 0o111:
+        raise DevTestRefused(f"{what} {path} is not executable")
+    parent = os.path.dirname(path)
+    while True:
+        pst = os.lstat(parent)
+        if stat.S_ISLNK(pst.st_mode) or pst.st_uid not in (trusted_uid, 0) or pst.st_mode & 0o022:
+            raise DevTestRefused(f"{what} directory {parent} is a symlink, foreign-owned or group/other writable")
+        if parent == "/":
+            return
+        parent = os.path.dirname(parent)
+
+
+def _read_nofollow(path: str, limit: int = 4 << 20) -> bytes:
+    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
+    try:
+        chunks, total = [], 0
+        while True:
+            chunk = os.read(fd, 65536)
+            if not chunk:
+                return b"".join(chunks)
+            total += len(chunk)
+            if total > limit:
+                raise DevTestRefused(f"{path} is larger than {limit} bytes")
+            chunks.append(chunk)
+    finally:
+        os.close(fd)
+
+
+def load_registry(path: Optional[str] = None, trusted_uid: Optional[int] = None) -> dict:
+    """The root-owned profile file, trust-checked on every call (no caching)."""
+    path = CONFIG_PATH if path is None else path
+    trusted_uid = TRUSTED_UID if trusted_uid is None else trusted_uid
+    _check_trusted(path, trusted_uid, "dev-test profile file")
+    try:
+        cfg = json.loads(_read_nofollow(path, 1 << 20).decode("utf-8"))
+    except (ValueError, UnicodeDecodeError) as exc:
+        raise DevTestRefused(f"dev-test profile file {path} is not valid JSON: {exc}")
+    if not isinstance(cfg, dict) or cfg.get("version") != 1 or not isinstance(cfg.get("profiles"), dict):
+        raise DevTestRefused(f"dev-test profile file {path} has an unsupported shape")
+    for key in ("helper", "helper_sha256", "python"):
+        if not isinstance(cfg.get(key), str) or not cfg[key]:
+            raise DevTestRefused(f"dev-test profile file {path} lacks {key}")
+    for name, prof in cfg["profiles"].items():
+        isolation = prof.get("isolation") if isinstance(prof, dict) else None
+        mode = isolation.get("mode") if isinstance(isolation, dict) else None
+        if not isinstance(mode, str) or not mode:
+            raise DevTestRefused(f"dev-test profile file {path}: profile {name!r} lacks isolation.mode")
+    return cfg
+
+
+def guard_registry(path: Optional[str] = None, trusted_uid: Optional[int] = None) -> dict:
+    """The root-owned profile file for the *additive guards* only: trust-checked and shape-checked
+    like ``load_registry`` but without the per-profile ``isolation.mode`` requirement, so an
+    older trusted registry keeps blocking credential reads. Never used to run or expose anything."""
+    path = CONFIG_PATH if path is None else path
+    trusted_uid = TRUSTED_UID if trusted_uid is None else trusted_uid
+    _check_trusted(path, trusted_uid, "dev-test profile file")
+    try:
+        cfg = json.loads(_read_nofollow(path, 1 << 20).decode("utf-8"))
+    except (ValueError, UnicodeDecodeError) as exc:
+        raise DevTestRefused(f"dev-test profile file {path} is not valid JSON: {exc}")
+    if not isinstance(cfg, dict) or cfg.get("version") != 1 or not isinstance(cfg.get("profiles"), dict):
+        raise DevTestRefused(f"dev-test profile file {path} has an unsupported shape")
+    return cfg
+
+
+def approved_profiles(cfg: dict) -> dict:
+    """Profiles whose declared isolation mode is the recognised *proposed* design string.
+
+    Syntactic config validity only: membership here says nothing about whether the design is
+    implemented, provisioned or attested on this host. Use ``runnable_profiles`` for readiness."""
+    out = {}
+    for name, prof in (cfg.get("profiles") or {}).items():
+        isolation = prof.get("isolation") if isinstance(prof, dict) else None
+        if isinstance(isolation, dict) and isolation.get("mode") == APPROVED_ISOLATION_MODE:
+            out[name] = prof
+    return out
+
+
+def backend_attested(cfg: dict, profile: str, prof: dict) -> Optional[str]:
+    """Why ``profile`` has no runnable isolation backend, or None once one is attested.
+
+    No backend for any isolation mode is implemented in this runtime, so every profile is
+    refused with ``NOT_IMPLEMENTED_REFUSAL``. The only acceptable way to return None is a
+    future implementation that probes a trusted broker for identity, liveness, schema and
+    capability on every call; a mode string, environment variable or configuration flag is
+    never attestation and must not be accepted here."""
+    return NOT_IMPLEMENTED_REFUSAL
+
+
+def runnable_profiles(cfg: dict) -> dict:
+    """Profiles that are both the recognised design *and* have an attested backend (none today)."""
+    out = {}
+    for name, prof in approved_profiles(cfg).items():
+        if backend_attested(cfg, name, prof) is None:
+            out[name] = prof
+    return out
+
+
+def check_isolation(cfg: dict, profile: str) -> None:
+    """Fail closed: a rejected mode names the rejection; the recognised mode without an attested
+    backend names the missing implementation. Nothing is runnable unless both pass."""
+    prof = cfg["profiles"].get(profile) or {}
+    approved = approved_profiles(cfg)
+    if profile not in approved:
+        mode = (prof.get("isolation") or {}).get("mode")
+        raise DevTestRefused(f"profile '{profile}' has isolation mode {mode!r}: {ISOLATION_REFUSAL}")
+    reason = backend_attested(cfg, profile, prof)
+    if reason is not None:
+        raise DevTestRefused(f"profile '{profile}' (isolation mode {APPROVED_ISOLATION_MODE!r}): {reason}")
+
+
+def registered_or_none() -> Optional[dict]:
+    """The trusted registry for the additive guards (lenient shape, see ``guard_registry``), or
+    None when it is absent or untrusted (guards never raise)."""
+    try:
+        return guard_registry()
+    except Exception:
+        return None
+
+
+def runnable_registry_or_none() -> Optional[dict]:
+    """The strictly validated registry, or None; readiness surfaces (tool visibility, recovery
+    directives) use this and then ``runnable_profiles``."""
+    try:
+        return load_registry()
+    except Exception:
+        return None
+
+
+def verify_runner(cfg: dict, trusted_uid: Optional[int] = None) -> str:
+    """Trust + pinned digest of the runner and trust of its interpreter; returns the interpreter."""
+    trusted_uid = TRUSTED_UID if trusted_uid is None else trusted_uid
+    helper = cfg["helper"]
+    _check_trusted(helper, trusted_uid, "trusted runner")
+    digest = hashlib.sha256(_read_nofollow(helper)).hexdigest()
+    if not re.fullmatch(r"[0-9a-f]{64}", cfg["helper_sha256"]) or not hmac.compare_digest(digest, cfg["helper_sha256"]):
+        raise DevTestRefused(f"trusted runner {helper} does not match the pinned SHA-256 (tampered or not "
+                             "re-registered after an update); refusing to run it")
+    python = cfg["python"]
+    if not os.path.isabs(python):
+        raise DevTestRefused("interpreter path must be absolute")
+    _check_trusted(os.path.realpath(python), 0, "runner interpreter", executable=True)
+    return python
+
+
+# --------------------------------------------------------------- context ---
+
+def worker_identity() -> tuple:
+    """(task id, run id) of the dispatcher-owned worker this process is; else refuse."""
+    try:
+        from agent.delegation_context import is_delegated_child_process_context, is_dispatcher_owned_worker_context
+    except Exception as exc:  # pragma: no cover - import failure means no verified context
+        raise DevTestRefused(f"cannot verify the worker context: {exc}")
+    task = (os.environ.get("HERMES_KANBAN_TASK") or "").strip()
+    run = (os.environ.get("HERMES_KANBAN_RUN_ID") or "").strip()
+    if not task or is_delegated_child_process_context() or not is_dispatcher_owned_worker_context():
+        raise DevTestRefused(f"{TOOL_NAME} runs only in the dispatcher-owned Kanban worker of the card "
+                             "(not in delegate_task children, cron runs or other sessions)")
+    if not re.fullmatch(r"t_[0-9a-f]{6,16}", task) or not re.fullmatch(r"[1-9][0-9]{0,9}", run):
+        raise DevTestRefused("this worker has no valid task/run identity")
+    return task, run
+
+
+@no_cache_check_fn
+def _check_fn() -> bool:
+    try:
+        worker_identity()
+    except DevTestRefused:
+        return False
+    cfg = runnable_registry_or_none()
+    return bool(cfg and runnable_profiles(cfg))
+
+
+# ------------------------------------------------------------- arguments ---
+
+def validate_args(args: dict, cfg: dict) -> dict:
+    if not isinstance(args, dict):
+        raise DevTestRefused("arguments must be an object")
+    unknown = set(args) - _ARG_KEYS
+    if unknown:
+        raise DevTestRefused(f"unknown arguments {sorted(unknown)}; {TOOL_NAME} takes only {sorted(_ARG_KEYS)} "
+                             "(database URLs, go flags and environment are fixed by the registered profile)")
+    profile = args.get("profile")
+    if not isinstance(profile, str) or not PROFILE_RE.match(profile) or profile not in cfg["profiles"]:
+        raise DevTestRefused(f"profile must be one of {sorted(cfg['profiles'])}")
+    packages = args.get("packages", ["./..."])
+    if isinstance(packages, str):
+        packages = [packages]
+    if (not isinstance(packages, list) or not packages or len(packages) > 32
+            or not all(isinstance(p, str) and PACKAGE_RE.match(p) for p in packages)):
+        raise DevTestRefused("packages must be 1-32 relative package patterns like ./... or ./internal/db")
+    run = args.get("run")
+    if run is not None and (not isinstance(run, str) or not RUN_FILTER_RE.match(run)):
+        raise DevTestRefused("run must be a test-name regex of [A-Za-z0-9_^$|()./*+?[]-] without spaces or quotes")
+    flags = {}
+    for key, default in (("race", True), ("short", False), ("vet", False)):
+        value = args.get(key, default)
+        if not isinstance(value, bool):
+            raise DevTestRefused(f"{key} must be true or false")
+        flags[key] = value
+    timeout = args.get("timeout_seconds", TIMEOUT_DEFAULT)
+    if isinstance(timeout, bool) or not isinstance(timeout, int) or not TIMEOUT_MIN <= timeout <= TIMEOUT_MAX:
+        raise DevTestRefused(f"timeout_seconds must be an integer {TIMEOUT_MIN}..{TIMEOUT_MAX}")
+    return {"profile": profile, "packages": packages, "run": run, "timeout": timeout, **flags}
+
+
+def runner_argv(cfg: dict, python: str, task: str, run_id: str, req: dict) -> list:
+    argv = [python, "-I", "-S", cfg["helper"], "run", "--task", task, "--run-id", run_id,
+            "--profile", req["profile"]]
+    for pkg in req["packages"]:
+        argv += ["--package", pkg]
+    argv.append("--race" if req["race"] else "--no-race")
+    if req["short"]:
+        argv.append("--short")
+    if req["run"]:
+        argv += ["--run", req["run"]]
+    if req["vet"]:
+        argv.append("--vet")
+    return argv + ["--timeout", str(req["timeout"])]
+
+
+def runner_budget(req: dict) -> int:
+    """Wall-clock budget for the runner process: go test timeout + grace (+ go vet's own budget)."""
+    return req["timeout"] + RUNNER_GRACE + (VET_BUDGET if req["vet"] else 0)
+
+
+def _redact(value):
+    try:
+        from agent.redact import redact_sensitive_text
+    except Exception:  # pragma: no cover
+        return value
+    if isinstance(value, str):
+        return redact_sensitive_text(value, force=True)
+    if isinstance(value, list):
+        return [_redact(v) for v in value]
+    if isinstance(value, dict):
+        return {_redact(k) if isinstance(k, str) else k: _redact(v) for k, v in value.items()}
+    return value
+
+
+# --------------------------------------------------------------- handler ---
+
+def dev_test_run(args: dict, *, config_path: Optional[str] = None, trusted_uid: Optional[int] = None,
+                 runner=subprocess.run) -> str:
+    # Recovery state: an argument-validation refusal leaves the pending recovery in place; a
+    # precondition outside the worker's control records the refusal; a started runner clears it.
+    try:
+        identity = worker_identity()
+    except DevTestRefused as exc:
+        return tool_error(f"{TOOL_NAME} refused: {exc}")
+    task, run_id = identity
+    try:
+        cfg = load_registry(config_path, trusted_uid)
+    except DevTestRefused as exc:
+        return _precondition_refused(identity, None, exc)
+    try:
+        req = validate_args(args, cfg)
+    except DevTestRefused as exc:
+        return tool_error(f"{TOOL_NAME} refused: {exc}")
+    try:
+        check_isolation(cfg, req["profile"])
+        python = verify_runner(cfg, trusted_uid)
+        argv = runner_argv(cfg, python, task, run_id, req)
+        command = shlex.join(argv)
+        from tools.approval import check_all_command_guards
+        verdict = check_all_command_guards(command, "local")
+        if not verdict.get("approved"):
+            raise DevTestRefused(f"the command guards rejected the fixed runner invocation: {verdict.get('message')}")
+    except DevTestRefused as exc:
+        return _precondition_refused(identity, req["profile"], exc)
+    budget = runner_budget(req)
+    started = time.monotonic()
+    try:
+        proc = runner(argv, env={"PATH": "/usr/bin:/bin", "LANG": "C.UTF-8"}, cwd="/", stdin=subprocess.DEVNULL,
+                      capture_output=True, text=True, timeout=budget, close_fds=True)
+    except subprocess.TimeoutExpired:
+        mark_recovery_attempted(identity, profile=req["profile"])
+        return tool_error(f"{TOOL_NAME}: the runner did not finish within {budget}s and was killed; its descendants "
+                          "(go test, test binaries) may still be running and need the kit's process-group cleanup")
+    except OSError as exc:
+        return _precondition_refused(identity, req["profile"],
+                                     DevTestRefused(f"could not start the trusted runner: {exc}"))
+    mark_recovery_attempted(identity, profile=req["profile"])
+    try:
+        result = json.loads(proc.stdout)
+        if not isinstance(result, dict):
+            raise ValueError("not an object")
+    except ValueError:
+        return tool_error(f"{TOOL_NAME}: the runner exited {proc.returncode} without a result: "
+                          f"{_redact((proc.stdout + proc.stderr)[-2000:])}")
+    result["runner_exit"] = proc.returncode
+    result["invocation"] = command
+    result["wall_seconds"] = round(time.monotonic() - started, 1)
+    if proc.returncode == 2:
+        result["next_step"] = ("The runner refused (see error). Fix the named precondition (preflight for the lease, "
+                               "an approved package) and call dev_test_run again, or block naming this error.")
+    elif proc.returncode == 3:
+        result["next_step"] = "The sandbox is unavailable on this host; block naming this error. Never run the tests unsandboxed."
+    elif proc.returncode == 1:
+        result["next_step"] = "Tests or vet failed: read failed_tests/build_output, fix the code, run dev_test_run again."
+    return json.dumps(_redact(result), ensure_ascii=False)
+
+
+# ----------------------------------------------------- scanner recovery ---
+
+_RECOVERY_LOCK = threading.Lock()
+_PENDING_RECOVERY: dict = {}  # (task, run) -> {"profile", "at"[, "refused"]}
+_GO_TEST_RE = re.compile(r"(?:^|[\s;&|(])go\s+(?:test|vet)\b")
+
+
+def _matching_profile(command: str, cfg: dict) -> Optional[str]:
+    """A RUNNABLE profile the rejected command corresponds to: recognised design *and* attested
+    backend. A rejected mode or a recognised mode without a backend never matches, so no
+    directive points the worker at a tool that cannot run."""
+    profiles = runnable_profiles(cfg)
+    for name, prof in sorted(profiles.items()):
+        db = prof.get("database") or {}
+        markers = [str(db.get("url_env") or ""), str(db.get("pgpassfile") or ""),
+                   f"{db.get('host')}:{db.get('port')}", f"/{db.get('dbname')}"]
+        if any(m and m in command for m in markers if m not in ("None:None", "/None")):
+            return name
+    if len(profiles) == 1 and re.search(r"PGPASSFILE|DATABASE_URL", command):
+        return next(iter(profiles))
+    return None
+
+
+def recovery_hint(command: str) -> str:
+    """Directive appended to an unattended rejection when a registered equivalent exists."""
+    if not command or not _GO_TEST_RE.search(command):
+        return ""
+    try:
+        identity = worker_identity()
+    except DevTestRefused:
+        return ""
+    cfg = runnable_registry_or_none()
+    if not cfg:
+        return ""
+    profile = _matching_profile(command, cfg)
+    if not profile:
+        return ""
+    with _RECOVERY_LOCK:
+        _PENDING_RECOVERY[identity] = {"profile": profile, "at": time.time()}
+    return (f" RECOVERY: an approved equivalent exists. Do not retry, wrap, encode or script this command. "
+            f"Call {TOOL_NAME}(profile=\"{profile}\", packages=[\"./...\"], race=true, vet=<true if you also need "
+            f"go vet>, run=<optional test regex>) once as a new request; it runs the registered Go/PostgreSQL tests "
+            f"with the operator's credential file in a sandbox and returns exit code and pass/fail/skip counts. "
+            f"Continue from its result; block only if {TOOL_NAME} itself refuses, quoting its error.")
+
+
+def _current_identity() -> Optional[tuple]:
+    try:
+        return worker_identity()
+    except DevTestRefused:
+        return None
+
+
+def pending_recovery() -> Optional[dict]:
+    """The recovery entry of the current worker (task, run); None without a worker identity."""
+    identity = _current_identity()
+    if identity is None:
+        return None
+    with _RECOVERY_LOCK:
+        entry = _PENDING_RECOVERY.get(identity)
+        return dict(entry) if entry else None
+
+
+def mark_recovery_attempted(identity: Optional[tuple] = None, *, profile: Optional[str] = None,
+                            refused: Optional[str] = None) -> None:
+    """Resolve the pending recovery of ``identity`` (default: the current worker): drop it, or with
+    ``refused`` record the precondition refusal on it. A ``profile`` other than the one the
+    directive named resolves nothing."""
+    identity = identity or _current_identity()
+    if identity is None:
+        return
+    with _RECOVERY_LOCK:
+        entry = _PENDING_RECOVERY.get(identity)
+        if not entry or (profile is not None and entry.get("profile") != profile):
+            return
+        if refused is None:
+            del _PENDING_RECOVERY[identity]
+        else:
+            entry["refused"] = refused
+
+
+def _reset_recovery_state() -> None:
+    """Tests only: forget every worker's recovery state."""
+    with _RECOVERY_LOCK:
+        _PENDING_RECOVERY.clear()
+
+
+def _precondition_refused(identity: tuple, profile: Optional[str], exc: Exception) -> str:
+    message = f"{TOOL_NAME} refused: {exc}"
+    mark_recovery_attempted(identity, profile=profile, refused=message)
+    return tool_error(message)
+
+
+def block_refusal() -> Optional[str]:
+    """kanban_block refusal while a rejected command's approved equivalent is untried (a recorded
+    precondition refusal lets the worker block, quoting it)."""
+    pending = pending_recovery()
+    if not pending or pending.get("refused"):
+        return None
+    return (f"Not blocked: a terminal command was rejected by the security scanner but an approved equivalent "
+            f"exists and has not been tried. Call {TOOL_NAME}(profile=\"{pending['profile']}\", ...) first, verify "
+            f"its result and continue; block only if {TOOL_NAME} refuses (quote its error).")
+
+
+# ------------------------------------------------------- command guards ---
+
+_CONTAINER_VERBS = r"(?:exec|inspect|cp|export|commit|attach|top|diff)"
+
+
+def credential_block(command: str) -> Optional[str]:
+    """Hard block for commands that would read a registered test credential into the conversation:
+    the credential file (any reference other than a plain ``PGPASSFILE=<path>`` assignment, which
+    hands the path to a client without reading it) and the registered container's environment."""
+    if not command:
+        return None
+    cfg = registered_or_none()
+    if not cfg:
+        return None
+    home = os.path.expanduser("~")
+    for name, prof in cfg.get("profiles", {}).items():
+        db = prof.get("database") or {}
+        path = db.get("pgpassfile")
+        if isinstance(path, str) and path:
+            text = re.sub(r"(?:^|(?<=[\s;&|(]))PGPASSFILE=(['\"]?)" + re.escape(path) + r"\1(?=\s)", " ", command)
+            forms = {path, os.path.dirname(path)}
+            if path.startswith(home + "/"):
+                rel = path[len(home) + 1:]
+                forms |= {f"~/{rel}", f"$HOME/{rel}", f"${{HOME}}/{rel}",
+                          f"~/{os.path.dirname(rel)}", f"$HOME/{os.path.dirname(rel)}"}
+            if any(f and f in text for f in forms) or re.search(r"\$\{?PGPASSFILE\b", text):
+                return (f"BLOCKED: this command references the registered test-database credential file of "
+                        f"profile '{name}'. Its contents must never enter the conversation or logs. Run the tests "
+                        f"with {TOOL_NAME}(profile=\"{name}\"); it hands the file to the sandboxed tests only.")
+        container = prof.get("container")
+        if isinstance(container, str) and container and re.search(
+                r"\b(?:docker|podman)\s+(?:container\s+)?" + _CONTAINER_VERBS + r"\b[^;&|\n]*\b" + re.escape(container) + r"\b",
+                command):
+            return (f"BLOCKED: reading or entering the registered test-database container '{container}' would "
+                    f"expose its credentials. Use {TOOL_NAME}(profile=\"{name}\") for the tests.")
+    return None
+
+
+_DB_URL_RE = re.compile(r"(?i)\b(?:postgres(?:ql)?|mysql|mariadb|mongodb(?:\+srv)?|rediss?)://([^\s'\"/?#]*)([^\s'\"]*)")
+_PG_CLIENT_RE = re.compile(r"(?:^|[\s;&|(])(?:psql|pg_dump|pg_dumpall|pg_restore|pgbench|createdb|dropdb|vacuumdb|"
+                           r"reindexdb|clusterdb|pg_isready)\b([^;&|\n]*)")
+_LOOPBACK = {"127.0.0.1", "localhost", "::1", ""}
+_ENV_PREFIX = r"(?:^|[\s;&|(])"
+
+
+def _hosts_of(authority: str) -> tuple:
+    """(userinfo, [hosts]) of a URL authority; a multi-host authority yields every host."""
+    userinfo, _, hostports = authority.rpartition("@")
+    hosts = []
+    for hostport in hostports.split(","):
+        if hostport.startswith("["):
+            host = hostport[1:].split("]", 1)[0]
+        else:
+            host = hostport.rsplit(":", 1)[0] if hostport.count(":") <= 1 else hostport
+        hosts.append(host.lower())
+    return userinfo, hosts
+
+
+def _non_loopback(value: str) -> Optional[str]:
+    """First host of a (comma-separated) host list that is neither loopback nor a socket directory."""
+    from urllib.parse import unquote
+    for host in unquote(value).split(","):
+        host = host.strip().lower()
+        if host.startswith("[") and host.endswith("]"):
+            host = host[1:-1]
+        if host not in _LOOPBACK and not host.startswith("/"):
+            return host
+    return None
+
+
+def _host_refusal(host: str) -> str:
+    return f"database host '{host}' is not an approved loopback development database"
+
+
+_SERVICE_REFUSAL = ("a libpq service (PGSERVICE/PGSERVICEFILE/service=) names an unresolvable database target; "
+                    f"use the registered profile through {TOOL_NAME}")
+
+
+def database_target_block(command: str) -> Optional[str]:
+    """Unattended contexts only: database connection targets other than loopback, and passwords
+    written into a command line, are refused (nobody can approve a production connection).
+
+    This is NOT a security boundary: it is an additive text guard over the command string and
+    cannot see targets set indirectly (config files, variables expanded at run time, programs
+    choosing their own target). It only refuses more; it never approves anything."""
+    if not command:
+        return None
+    for m in _DB_URL_RE.finditer(command):
+        userinfo, hosts = _hosts_of(m.group(1))
+        if ":" in userinfo:
+            return ("a database password written into the command line (use the registered credential file "
+                    f"through {TOOL_NAME})")
+        for host in hosts:
+            if host not in _LOOPBACK:
+                return _host_refusal(host)
+        for qm in re.finditer(r"(?i)[?&](host|hostaddr|service)=([^&#]*)", m.group(2)):
+            if qm.group(1).lower() == "service":
+                return _SERVICE_REFUSAL
+            bad = _non_loopback(qm.group(2))
+            if bad is not None:
+                return _host_refusal(bad)
+    for m in _PG_CLIENT_RE.finditer(command):
+        args = m.group(1)
+        for hm in re.finditer(r"(?:^|\s)(?:-h\s*|--host[=\s]+)(['\"]?)([^\s'\"]+)\1|\b(?:host|hostaddr)=([^\s'\"]+)",
+                              args):
+            bad = _non_loopback(hm.group(2) or hm.group(3) or "")
+            if bad is not None:
+                return _host_refusal(bad)
+        if re.search(r"(?:^|[\s'\"])service=", args):
+            return _SERVICE_REFUSAL
+    for m in re.finditer(_ENV_PREFIX + r"(?:PGHOST|PGHOSTADDR)=(['\"]?)([^\s'\"]+)\1", command):
+        bad = _non_loopback(m.group(2))
+        if bad is not None:
+            return _host_refusal(bad)
+    if re.search(_ENV_PREFIX + r"PGSERVICE(?:FILE)?=", command):
+        return _SERVICE_REFUSAL
+    return None
+
+
+# ----------------------------------------------------------------- schema ---
+
+DEV_TEST_RUN_SCHEMA = {
+    "name": TOOL_NAME,
+    "description": (
+        "Run the operator-registered Go/PostgreSQL development tests of this card's checkout in a trusted "
+        "sandbox (go test -json -count=1 -p=1, -race by default, optional go vet). Use it instead of a terminal "
+        "`PGPASSFILE=... *_DATABASE_URL=... go test` command, which the security scanner rejects in unattended "
+        "runs. The database URL and credential file come from the registered profile; never pass, read or print "
+        "them. Needs this run's repository lease (workflow.py preflight). Returns exit_code, tests "
+        "{passed, failed, skipped}, skipped_tests with reasons, failed_tests with output, packages and vet."
+    ),
+    "parameters": {
+        "type": "object",
+        "properties": {
+            "profile": {"type": "string", "description": "Registered profile name, e.g. example-service."},
+            "packages": {"type": "array", "items": {"type": "string"},
+                         "description": "Package patterns inside the profile's approved set: ./... (default) or "
+                                        "./internal/db, ./internal/..."},
+            "run": {"type": "string", "description": "Optional go test -run regex (no spaces or quotes)."},
+            "race": {"type": "boolean", "description": "Race detector (default true)."},
+            "short": {"type": "boolean", "description": "go test -short (default false)."},
+            "vet": {"type": "boolean", "description": "Also run go vet on the same packages (default false)."},
+            "timeout_seconds": {"type": "integer", "minimum": TIMEOUT_MIN, "maximum": TIMEOUT_MAX,
+                                "description": "go test -timeout (default 1200)."},
+        },
+        "required": ["profile"],
+        "additionalProperties": False,
+    },
+}
+
+registry.register(
+    name=TOOL_NAME,
+    toolset="kanban",
+    schema=DEV_TEST_RUN_SCHEMA,
+    handler=lambda args, **kw: dev_test_run(args),
+    check_fn=_check_fn,
+    emoji="🧪",
+)

+def _is_registered_devtest_credential(resolved: Path) -> bool:
+    """The credential files (and their directories) named by the root-owned dev-test profile
+    registry (tools.dev_test_tool); no registry means nothing extra is blocked."""
+    try:
+        from tools.dev_test_tool import registered_or_none
+        cfg = registered_or_none()
+    except Exception:
+        return False
+    for prof in (cfg or {}).get("profiles", {}).values():
+        path = ((prof or {}).get("database") or {}).get("pgpassfile")
+        if isinstance(path, str) and path:
+            target = Path(path).resolve()
+            if resolved == target or _is_under(resolved, target.parent):
+                return True
+    return False
+

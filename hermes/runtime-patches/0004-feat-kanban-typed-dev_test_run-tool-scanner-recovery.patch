+def test_run370_command_is_rejected_with_a_recovery_directive(attested_backend, headless, registry_file, worker_env):
+    verdict = check_all_command_guards(SCANNER_BLOCKED_CMD, "local")
+    assert verdict["approved"] is False
+    # The exact run-370 finding: Tirith raw_ip_url + schemeless_to_sink (MEDIUM), single-query deny.
+    assert "[MEDIUM] URL uses raw IP address" in verdict["message"]
+    assert "Schemeless URL in sink context" in verdict["message"]
+    assert "single-query mode (-q)" in verdict["message"]
+    assert "RECOVERY" in verdict["message"] and 'dev_test_run(profile="example-service"' in verdict["message"]
+    assert dtt.pending_recovery()["profile"] == "example-service"
+    refusal = dtt.block_refusal()
+    assert refusal and "dev_test_run" in refusal
+    dtt.mark_recovery_attempted()
+    assert dtt.block_refusal() is None
+
+
+def test_rejection_without_registered_equivalent_has_no_directive(headless, worker_env, monkeypatch):
+    monkeypatch.setattr(dtt, "CONFIG_PATH", "/nonexistent/profiles.json")
+    verdict = check_all_command_guards(SCANNER_BLOCKED_CMD, "local")
+    assert verdict["approved"] is False
+    assert "RECOVERY" not in verdict["message"]
+    assert dtt.block_refusal() is None
+

+@pytest.fixture
+def attested_backend(monkeypatch):
+    """Simulates a FUTURE attested broker so the recovery state machine and the fixed runner
+    invocation can be exercised. Production ``backend_attested`` never returns None today: no
+    isolation backend is implemented, so the tests below that use this fixture describe how the
+    tool would behave once a real broker probe exists, not what a worker can do now."""
+    monkeypatch.setattr(dtt, "backend_attested", lambda cfg, name, prof: None)
+
+
+@pytest.fixture
+def worker_env(monkeypatch):
+    monkeypatch.setenv("HERMES_KANBAN_TASK", "t_12345678")
+    monkeypatch.setenv("HERMES_KANBAN_RUN_ID", "77")
+    monkeypatch.delenv("HERMES_DELEGATED_CHILD", raising=False)
+    monkeypatch.delenv("HERMES_KANBAN_DELEGATED_CHILD", raising=False)
+

+# ---------------------------------------------------------------------------
+# command_allowlist pattern keys apply headlessly too
+# ---------------------------------------------------------------------------
+
+class TestPermanentAllowlistHonouredHeadless:
+    """An operator's permanent "Always" answer lands in ``command_allowlist`` as a
+    dangerous-pattern key. Interactive sessions honour it; a -q worker (Kanban dispatcher
+    runs ``hermes chat -q``) used to ignore it and deny the very command the operator had
+    approved for good. The standing decision now applies in -q / cron too; session-only
+    approvals (no human present) and the hardline floor are unchanged."""
+
+    COMMAND = "python3 -c 'print(1)'"
+    KEY = "script execution via -e/-c flag"
+
+    @pytest.fixture(autouse=True)
+    def _headless(self, monkeypatch):
+        monkeypatch.setenv("HERMES_SINGLE_QUERY_SESSION", "1")
+        monkeypatch.setenv("HERMES_INTERACTIVE", "1")
+        monkeypatch.delenv("HERMES_GATEWAY_SESSION", raising=False)
+        monkeypatch.delenv("HERMES_YOLO_MODE", raising=False)
+        from unittest.mock import patch as mock_patch
+        with mock_patch("tools.approval_context._get_single_query_approval_mode", return_value="deny"), \
+                mock_patch("tools.approval_context._get_approval_mode", return_value="manual"), \
+                mock_patch("tools.approval._tirith_scan", return_value={"action": "allow", "findings": []}):
+            yield
+
+    def test_pattern_key_is_detected_for_the_command(self):
+        is_dangerous, key, _ = detect_dangerous_command(self.COMMAND)
+        assert is_dangerous and key == self.KEY
+
+    def test_denied_without_a_permanent_entry(self):
+        result = check_all_command_guards(self.COMMAND, "local")
+        assert not result["approved"] and "single_query_mode" in result["message"]
+
+    def test_permanent_pattern_key_approves_headlessly(self):
+        approval_module.approve_permanent(self.KEY)
+        assert check_all_command_guards(self.COMMAND, "local")["approved"]
+        assert check_dangerous_command(self.COMMAND, "local")["approved"]
+
+    def test_session_only_approval_does_not_count(self):
+        approval_module.approve_session("default", self.KEY)
+        approval_module.approve_session("test-session", self.KEY)
+        assert not check_all_command_guards(self.COMMAND, "local")["approved"]
+
+    def test_other_pattern_keys_stay_denied(self):
+        approval_module.approve_permanent(self.KEY)
+        result = check_all_command_guards("rm -rf /tmp/stuff", "local")
+        assert not result["approved"] and "dangerous" in result["message"].lower()
+
+    def test_hardline_floor_ignores_the_allowlist(self):
+        approval_module.approve_permanent(self.KEY)
+        approval_module.approve_permanent("recursive delete")
+        result = check_all_command_guards("rm -rf /", "local")
+        assert not result["approved"]
+
+    def test_cron_context_honours_it_too(self, monkeypatch):
+        monkeypatch.delenv("HERMES_SINGLE_QUERY_SESSION", raising=False)
+        monkeypatch.setenv("HERMES_CRON_SESSION", "1")
+        from unittest.mock import patch as mock_patch
+        with mock_patch("tools.approval_context._get_cron_approval_mode", return_value="deny"):
+            assert not check_all_command_guards(self.COMMAND, "local")["approved"]
+            approval_module.approve_permanent(self.KEY)
+            assert check_all_command_guards(self.COMMAND, "local")["approved"]

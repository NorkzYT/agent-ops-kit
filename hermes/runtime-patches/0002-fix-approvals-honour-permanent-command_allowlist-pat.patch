@@ -312,6 +312,16 @@ def _permanent_set() -> set:
     return approved
 
 
+def _permanently_approved_pattern(pattern_key: str) -> bool:
+    """``command_allowlist`` (the operator's "Always" answers) holds this dangerous-pattern
+    key or a legacy alias. Permanent entries only: session approvals need a human present,
+    which the headless contexts that call this never have."""
+    aliases = _approval_key_aliases(pattern_key)
+    with _lock:
+        approved = set(_permanent_set())
+    return any(alias in approved for alias in aliases)
+
+
 def is_approved(session_key: str, pattern_key: str) -> bool:
     """Session-scoped or permanent approval. Accepts the canonical key and the legacy
     regex-derived key so existing command_allowlist entries survive key migrations."""
@@ -548,6 +558,11 @@ def _unattended_deny(command: str, ctx: _Unattended) -> dict | None:
             advice="Find an alternative approach that avoids this command.")}
 
     is_dangerous, _pk, description = detect_dangerous_command(command)
+    # The operator's permanent "Always" answer (command_allowlist pattern key) is a standing
+    # decision, so it applies to -q / cron / unattended runs as it does interactively; the
+    # hardline floor already ran before this gate and tirith still scans the command below.
+    if is_dangerous and _permanently_approved_pattern(_pk):
+        is_dangerous = False
     if is_dangerous:
         result = block(f"Command flagged as dangerous ({description})")
         if ctx.name == "single_query":

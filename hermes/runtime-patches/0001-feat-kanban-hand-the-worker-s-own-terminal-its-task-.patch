+class TestIdentityVerification:
+    def test_child_of_the_worker_verifies_by_ancestry(self, worker_env):
+        env = supervised_worker_terminal_env(dict(os.environ))
+        env["PATH"] = os.environ.get("PATH", "")
+        assert _probe(env) == ["t_own", 41, os.getpid()]
+
+    def test_copied_env_in_a_process_the_worker_did_not_spawn_is_rejected(self, worker_env):
+        """The worker pid must be an ancestor: a sibling process (here `sleep`) that merely
+        received a copy of the env is not supervised by it (stale pid / PID reuse / copy)."""
+        sibling = subprocess.Popen(["sleep", "30"], stdin=subprocess.DEVNULL)
+        try:
+            env = supervised_worker_terminal_env(dict(os.environ))
+            env["PATH"] = os.environ.get("PATH", "")
+            env[SUPERVISED_WORKER_PID_ENV] = str(sibling.pid)
+            assert _probe(env) is None
+        finally:

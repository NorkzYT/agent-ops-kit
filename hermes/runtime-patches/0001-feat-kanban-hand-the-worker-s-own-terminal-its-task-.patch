 from __future__ import annotations
 
 import os
 from contextlib import contextmanager
 from contextvars import ContextVar, Token
-from typing import Iterator, Mapping, MutableMapping, overload
+from typing import Iterator, Mapping, MutableMapping, NamedTuple, Optional, overload
 
 _DELEGATED_CHILD_CONTEXT: ContextVar[bool] = ContextVar("hermes_delegated_child_context", default=False)
 # Any in-process execution that is NOT the dispatcher-owned worker (cron jobs). Kept separate
@@ -24,6 +36,13 @@ KANBAN_ENV_KEYS: tuple[str, ...] = (
     "HERMES_KANBAN_GOAL_MODE", "HERMES_KANBAN_GOAL_MAX_TURNS",
 )
 
+# Supervised worker terminal: the dispatcher-owned worker's own terminal tool receives these
+# in addition to the descendant fence. Identity, never authority: the claim lock stays out and
+# lifecycle transitions (complete/block/review) remain in-process tool calls of the worker.
+SUPERVISED_TERMINAL_ENV_MARKER = "HERMES_KANBAN_SUPERVISED_TERMINAL"
+SUPERVISED_WORKER_PID_ENV = "HERMES_KANBAN_SUPERVISED_WORKER_PID"
+SUPERVISED_IDENTITY_KEYS: tuple[str, ...] = ("HERMES_KANBAN_TASK", "HERMES_KANBAN_RUN_ID")
+
 
 @contextmanager
 def delegated_child_context(session_id: str | None = None) -> Iterator[None]:
@@ -110,3 +129,100 @@ def delegated_child_subprocess_env(
             or (env and (env.get("HERMES_KANBAN_TASK") or env.get(DELEGATED_CHILD_ENV_MARKER)))):
         return None if env is None else dict(env)
     return scrub_kanban_env(os.environ if env is None else env)
+
+
+def supervised_worker_terminal_env(
+    env: Mapping[str, str] | MutableMapping[str, str] | None = None,
+) -> dict[str, str] | None:
+    """Env for the dispatcher-owned worker's OWN terminal tool.
+
+    Applies the descendant fence first (:func:`delegated_child_subprocess_env`), then, only
+    when THIS process is the dispatcher-owned worker (not a delegate_task child, not a cron
+    run inside the worker), re-attaches the worker's own task id and run id from
+    ``os.environ`` plus the supervised marker and this pid. Values never come from the
+    caller-supplied *env*, so a child cannot smuggle a foreign task id through the terminal.
+    The claim lock is never forwarded. Everything else (None/dict contract, secret policy)
+    matches :func:`delegated_child_subprocess_env`.
+    """
+    scoped = delegated_child_subprocess_env(env)
+    if scoped is None:
+        return None
+    task = (os.environ.get("HERMES_KANBAN_TASK") or "").strip()
+    if not task or not is_dispatcher_owned_worker_context():
+        return scoped
+    scoped["HERMES_KANBAN_TASK"] = task
+    run_id = (os.environ.get("HERMES_KANBAN_RUN_ID") or "").strip()
+    if run_id:
+        scoped["HERMES_KANBAN_RUN_ID"] = run_id
+    else:
+        scoped.pop("HERMES_KANBAN_RUN_ID", None)
+    scoped[SUPERVISED_TERMINAL_ENV_MARKER] = "1"
+    scoped[SUPERVISED_WORKER_PID_ENV] = str(os.getpid())
+    return scoped
+
+
+class SupervisedTerminalIdentity(NamedTuple):
+    """Verified identity of the worker a supervised terminal process descends from."""
+
+    task_id: str
+    run_id: Optional[int]
+    worker_pid: int
+
+
+def _proc_parent_pid(pid: int) -> Optional[int]:
+    """PPid of *pid* from ``/proc`` (Linux). None when the process is gone or unreadable."""
+    try:
+        with open(f"/proc/{pid}/status", "r", encoding="utf-8", errors="replace") as fh:
+            for line in fh:
+                if line.startswith("PPid:"):
+                    return int(line.split(":", 1)[1].strip() or 0)
+    except (OSError, ValueError):
+        return None
+    return None
+
+
+def is_process_ancestor(ancestor_pid: int, pid: Optional[int] = None, *, max_depth: int = 64) -> bool:
+    """True when *ancestor_pid* is *pid* (default: this process) or one of its ancestors.
+
+    Walks ``/proc/<pid>/status`` PPid links; any unreadable or missing link ends the walk
+    with False (fail closed). Linux only: elsewhere there is no ``/proc`` and the result is
+    False, which keeps the supervised grant denied there.
+    """
+    current = os.getpid() if pid is None else pid
+    for _ in range(max_depth):
+        if current == ancestor_pid:
+            return True
+        if current <= 1:
+            return False
+        parent = _proc_parent_pid(current)
+        if parent is None or parent == current:
+            return False
+        current = parent
+    return False
+
+
+def supervised_terminal_identity() -> Optional[SupervisedTerminalIdentity]:
+    """Identity of the supervising worker when this process runs in its terminal.
+
+    Requires the supervised marker, a task id, a numeric worker pid, and that the worker pid
+    is an ancestor of this process (so a copied environment in an unrelated process, or a
+    stale env after the worker exited, yields None). A non-numeric run id yields None rather
+    than a partial identity. Callers still verify the triple against the board
+    (``worker_pid``/``current_run_id`` of the task) before granting anything.
+    """
+    if (os.environ.get(SUPERVISED_TERMINAL_ENV_MARKER) or "").strip() != "1":
+        return None
+    task = (os.environ.get("HERMES_KANBAN_TASK") or "").strip()
+    raw_pid = (os.environ.get(SUPERVISED_WORKER_PID_ENV) or "").strip()
+    raw_run = (os.environ.get("HERMES_KANBAN_RUN_ID") or "").strip()
+    if not task or not raw_pid.isdigit():
+        return None
+    run_id: Optional[int] = None
+    if raw_run:
+        if not raw_run.isdigit():
+            return None
+        run_id = int(raw_run)
+    worker_pid = int(raw_pid)
+    if worker_pid <= 1 or worker_pid == os.getpid() or not is_process_ancestor(worker_pid):
+        return None
+    return SupervisedTerminalIdentity(task_id=task, run_id=run_id, worker_pid=worker_pid)

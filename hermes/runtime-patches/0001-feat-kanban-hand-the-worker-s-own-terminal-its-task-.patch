+def _probe(env):
+    proc = subprocess.run([sys.executable, "-c", IDENTITY_PROBE], env=env, capture_output=True, text=True,
+                          stdin=subprocess.DEVNULL, timeout=45)
+    assert proc.returncode == 0, proc.stderr
+    return json.loads(proc.stdout.split("IDENT=", 1)[1])

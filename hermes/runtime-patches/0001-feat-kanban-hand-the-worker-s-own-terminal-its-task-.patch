+def _worker_board(tmp_path, monkeypatch):
+    db = tmp_path / "board.db"
+    conn = connect(db)
+    own, foreign = [kb.create_task(conn, title=title) for title in ("own", "foreign")]
+    for tid in (own, foreign):
+        kb.claim_task(conn, tid)
+    conn.execute("UPDATE tasks SET worker_pid = ? WHERE id = ?", (os.getpid(), own))
+    conn.commit()
+    task = kb.get_task(conn, own)
+    for key, value in {
+        "HERMES_KANBAN_DB": str(db), "HERMES_KANBAN_BOARD": "default",
+        "HERMES_KANBAN_TASK": own, "HERMES_KANBAN_RUN_ID": str(task.current_run_id),
+        "HERMES_KANBAN_CLAIM_LOCK": task.claim_lock, "HOME": str(tmp_path),
+    }.items():
+        monkeypatch.setenv(key, value)
+    for key in (DELEGATED_CHILD_ENV_MARKER, SUPERVISED_TERMINAL_ENV_MARKER, SUPERVISED_WORKER_PID_ENV):
+        monkeypatch.delenv(key, raising=False)
+    return conn, own, foreign
+
+
+def _cli(terminal, *argv):
+    cmd = f"cd {shlex.quote(str(ROOT))} && {shlex.quote(sys.executable)} -m hermes_cli.main kanban " + " ".join(
+        shlex.quote(a) for a in argv)
+    result = terminal.execute(cmd, timeout=60)
+    return int(result.get("returncode", 1) if result.get("returncode") is not None else 1), result.get("output", "")
+
+
+def test_worker_terminal_records_on_its_own_card_and_builds_its_cards_only(tmp_path, monkeypatch):
+    conn, own, foreign = _worker_board(tmp_path, monkeypatch)
+    terminal = LocalEnvironment(cwd=str(tmp_path))
+    try:
+        rc, out = _cli(terminal, "comment", own, "progress from the worker terminal", "--author", "kanban-workflow")
+        assert rc == 0, out
+        rc, out = _cli(terminal, "comment", foreign, "must refuse")
+        assert rc != 0 and "own card" in out, out
+        rc, out = _cli(terminal, "heartbeat", own)
+        assert rc == 0, out
+        # Lifecycle stays in-process: the terminal cannot finish, block or review the card.
+        for action in (["complete", own, "--result", "no"], ["block", own, "no"],
+                       ["request-review", own, "--summary", "no"], ["unblock", own], ["claim", foreign]):
+            rc, out = _cli(terminal, *action)
+            assert rc != 0 and "supervised terminal may not run" in out, (action, out)
+        rc, out = _cli(terminal, "create", "[mac 1] child", "--created-by", "kanban-workflow", "--json")
+        assert rc == 0, out
+        child = json.loads(out[out.index("{"):out.rindex("}") + 1])["id"]
+        rc, out = _cli(terminal, "create", "[round 1] child", "--created-by", "kanban-workflow", "--json")
+        assert rc == 0, out
+        rnd = json.loads(out[out.index("{"):out.rindex("}") + 1])["id"]
+        assert _cli(terminal, "link", child, rnd)[0] == 0           # both created by the worker
+        assert _cli(terminal, "link", own, child)[0] == 0           # own card as parent
+        rc, out = _cli(terminal, "link", foreign, rnd)
+        assert rc == 0, out                                         # rnd is ours; foreign is the dependency
+        rc, out = _cli(terminal, "comment", child, "lane evidence", "--author", "kanban-workflow")
+        assert rc == 0, out
+        rc, out = _cli(terminal, "link", foreign, own)
+        assert rc == 0, out
+        other = kb.create_task(conn, title="someone else's")
+        rc, out = _cli(terminal, "link", foreign, other)
+        assert rc != 0 and "owns or created" in out, out
+        rc, out = _cli(terminal, "comment", other, "no")
+        assert rc != 0, out
+    finally:
+        terminal.cleanup()
+    assert [c.body for c in kb.list_comments(conn, own)] == ["progress from the worker terminal"]
+    assert kb.get_task(conn, own).status == "running" and kb.get_task(conn, foreign).status == "running"
+    assert not kb.list_comments(conn, foreign)
+    created = conn.execute("SELECT payload FROM task_events WHERE task_id = ? AND kind = 'created'", (child,)).fetchone()
+    assert json.loads(created[0])["creator_task_id"] == own
+    assert conn.execute("PRAGMA integrity_check").fetchone()[0] == "ok"
+    conn.close()
+
+
+def test_delegate_child_terminal_and_stale_identity_are_denied(tmp_path, monkeypatch):
+    conn, own, foreign = _worker_board(tmp_path, monkeypatch)
+    terminal = LocalEnvironment(cwd=str(tmp_path))
+    try:
+        with delegated_child_context():
+            rc, out = _cli(terminal, "comment", own, "from a delegate child")
+        assert rc != 0 and "delegate_task child contexts cannot mutate" in out, out
+        # Board says another worker pid owns the run now (stale env after a reclaim).
+        conn.execute("UPDATE tasks SET worker_pid = ? WHERE id = ?", (os.getpid() + 100000, own)); conn.commit()
+        rc, out = _cli(terminal, "comment", own, "stale")
+        assert rc != 0 and "does not match the board" in out, out
+        conn.execute("UPDATE tasks SET worker_pid = ? WHERE id = ?", (os.getpid(), own)); conn.commit()
+        assert kb.block_task(conn, own, reason="fixture")
+        rc, out = _cli(terminal, "comment", own, "blocked card")
+        assert rc != 0 and "does not match the board" in out, out
+    finally:
+        terminal.cleanup()
+    assert not kb.list_comments(conn, own)
+    conn.close()

--- /dev/null
+++ b/tests/tools/test_kanban_supervised_terminal.py
@@ -0,0 +1,330 @@
+"""Supervised worker terminal: the dispatcher-owned worker's OWN terminal keeps its task
+identity (task id, run id, worker pid; never the claim lock) while every other spawn surface,
+delegate_task child and cron run stays a fenced descendant. The CLI grants that terminal a
+narrow, board-verified scope: progress on its own card and the cards it creates; lifecycle
+transitions and foreign cards stay denied."""
+import json
+import os
+from pathlib import Path
+import shlex
+import subprocess
+import sys
+
+import pytest
+
+from agent.delegation_context import (
+    DELEGATED_CHILD_ENV_MARKER, SUPERVISED_TERMINAL_ENV_MARKER, SUPERVISED_WORKER_PID_ENV,
+    delegated_child_context, non_dispatcher_owned_context, supervised_terminal_identity,
+    supervised_worker_terminal_env,
+)
+from hermes_cli import kanban_db as kb
+from hermes_cli.kanban_db_connect import connect
+from tools.environments.local import LocalEnvironment, _make_run_env, hermes_subprocess_env
+
+
+ROOT = Path(__file__).resolve().parents[2]
+WORKER_ENV = {
+    "HERMES_KANBAN_TASK": "t_own", "HERMES_KANBAN_RUN_ID": "41", "HERMES_KANBAN_CLAIM_LOCK": "host:1",
+    "HERMES_KANBAN_DB": "/tmp/board.db", "HERMES_KANBAN_BOARD": "default",
+}
+
+
+@pytest.fixture
+def worker_env(monkeypatch):
+    for key, value in WORKER_ENV.items():
+        monkeypatch.setenv(key, value)
+    for key in (DELEGATED_CHILD_ENV_MARKER, SUPERVISED_TERMINAL_ENV_MARKER, SUPERVISED_WORKER_PID_ENV):
+        monkeypatch.delenv(key, raising=False)
+    return monkeypatch
+
+
+def _fenced_without_identity(env):
+    assert env[DELEGATED_CHILD_ENV_MARKER] == "1"
+    assert "HERMES_KANBAN_TASK" not in env and "HERMES_KANBAN_RUN_ID" not in env
+    assert "HERMES_KANBAN_CLAIM_LOCK" not in env
+    assert SUPERVISED_TERMINAL_ENV_MARKER not in env and SUPERVISED_WORKER_PID_ENV not in env
+
+
+class TestSupervisedEnv:
+    def test_worker_terminal_gets_identity_but_never_the_claim_lock(self, worker_env):
+        env = supervised_worker_terminal_env({**os.environ, "KEEP": "1"})
+        assert env["HERMES_KANBAN_TASK"] == "t_own" and env["HERMES_KANBAN_RUN_ID"] == "41"
+        assert env[SUPERVISED_TERMINAL_ENV_MARKER] == "1" and env[SUPERVISED_WORKER_PID_ENV] == str(os.getpid())
+        assert env[DELEGATED_CHILD_ENV_MARKER] == "1", "the descendant fence stays: a shell is not an owner"
+        assert "HERMES_KANBAN_CLAIM_LOCK" not in env
+        assert env["HERMES_KANBAN_DB"] == "/tmp/board.db" and env["KEEP"] == "1"
+
+    def test_identity_comes_from_the_process_not_the_caller_env(self, worker_env):
+        env = supervised_worker_terminal_env({"HERMES_KANBAN_TASK": "t_foreign", "HERMES_KANBAN_RUN_ID": "9"})
+        assert env["HERMES_KANBAN_TASK"] == "t_own" and env["HERMES_KANBAN_RUN_ID"] == "41"
+
+    def test_delegate_child_and_cron_contexts_stay_fenced(self, worker_env):
+        with delegated_child_context():
+            _fenced_without_identity(supervised_worker_terminal_env(dict(os.environ)))
+        with non_dispatcher_owned_context():
+            _fenced_without_identity(supervised_worker_terminal_env(dict(os.environ)))
+
+    def test_descendant_of_the_terminal_cannot_regain_ownership(self, worker_env):
+        """A `hermes` CLI started from the worker terminal inherits the fence; its own spawns
+        carry no identity grant beyond what the worker already handed down."""
+        terminal = supervised_worker_terminal_env(dict(os.environ))
+        worker_env.setenv(DELEGATED_CHILD_ENV_MARKER, "1")  # now we ARE that descendant
+        env = supervised_worker_terminal_env(terminal)
+        assert env[DELEGATED_CHILD_ENV_MARKER] == "1" and "HERMES_KANBAN_CLAIM_LOCK" not in env
+        assert env.get(SUPERVISED_WORKER_PID_ENV) == str(os.getpid()) or SUPERVISED_WORKER_PID_ENV not in env
+        from agent.delegation_context import is_dispatcher_owned_worker_context
+        assert not is_dispatcher_owned_worker_context()
+
+    def test_no_kanban_context_is_a_passthrough(self, monkeypatch):
+        for key in (*WORKER_ENV, DELEGATED_CHILD_ENV_MARKER):
+            monkeypatch.delenv(key, raising=False)
+        assert supervised_worker_terminal_env(None) is None
+        assert supervised_worker_terminal_env({"A": "1"}) == {"A": "1"}
+
+    def test_only_the_terminal_surface_hands_identity_back(self, worker_env):
+        terminal = _make_run_env({})
+        assert terminal["HERMES_KANBAN_TASK"] == "t_own" and terminal[SUPERVISED_TERMINAL_ENV_MARKER] == "1"
+        assert "HERMES_KANBAN_CLAIM_LOCK" not in terminal
+        _fenced_without_identity(hermes_subprocess_env(inherit_credentials=True))
+        from tools.code_execution_env import _build_child_env
+        from tools.mcp_tool_config import _build_safe_env
+        _fenced_without_identity(_build_child_env(rpc_endpoint="f", rpc_token="f", tmpdir="/tmp",
+                                                  child_python=sys.executable))
+        _fenced_without_identity(_build_safe_env({"HERMES_HOME": os.environ.get("HERMES_HOME", "/tmp")}))
+
+    def test_delegate_child_terminal_is_fenced(self, worker_env):
+        with delegated_child_context():
+            _fenced_without_identity(_make_run_env({}))
+
+
+IDENTITY_PROBE = (
+    "import json, sys; sys.path.insert(0, %r)\n"
+    "from agent.delegation_context import supervised_terminal_identity\n"
+    "i = supervised_terminal_identity()\n"
+    "print('IDENT=' + json.dumps(None if i is None else list(i)))\n"
+) % str(ROOT)
+
+
+def _probe(env):
+    proc = subprocess.run([sys.executable, "-c", IDENTITY_PROBE], env=env, capture_output=True, text=True,
+                          stdin=subprocess.DEVNULL, timeout=45)
+    assert proc.returncode == 0, proc.stderr
+    return json.loads(proc.stdout.split("IDENT=", 1)[1])
+
+
+class TestIdentityVerification:
+    def test_child_of_the_worker_verifies_by_ancestry(self, worker_env):
+        env = supervised_worker_terminal_env(dict(os.environ))
+        env["PATH"] = os.environ.get("PATH", "")
+        assert _probe(env) == ["t_own", 41, os.getpid()]
+
+    def test_copied_env_in_a_process_the_worker_did_not_spawn_is_rejected(self, worker_env):
+        """The worker pid must be an ancestor: a sibling process (here `sleep`) that merely
+        received a copy of the env is not supervised by it (stale pid / PID reuse / copy)."""
+        sibling = subprocess.Popen(["sleep", "30"], stdin=subprocess.DEVNULL)
+        try:
+            env = supervised_worker_terminal_env(dict(os.environ))
+            env["PATH"] = os.environ.get("PATH", "")
+            env[SUPERVISED_WORKER_PID_ENV] = str(sibling.pid)
+            assert _probe(env) is None
+        finally:
+            sibling.kill(); sibling.wait()
+
+    def test_malformed_or_missing_fields_fail_closed(self, worker_env):
+        base = supervised_worker_terminal_env(dict(os.environ))
+        for broken in ({SUPERVISED_WORKER_PID_ENV: "abc"}, {"HERMES_KANBAN_RUN_ID": "x1"},
+                       {SUPERVISED_TERMINAL_ENV_MARKER: "0"}, {"HERMES_KANBAN_TASK": ""}):
+            env = {**base, **broken, "PATH": os.environ.get("PATH", "")}
+            assert _probe(env) is None, broken
+        worker_env.setenv(SUPERVISED_WORKER_PID_ENV, str(os.getpid()))
+        worker_env.setenv(SUPERVISED_TERMINAL_ENV_MARKER, "1")
+        assert supervised_terminal_identity() is None, "a process is never its own supervising worker"
+
+
+# --------------------------------------------------------------------- CLI grant ---
+
+def _worker_board(tmp_path, monkeypatch):
+    db = tmp_path / "board.db"
+    conn = connect(db)
+    own, foreign = [kb.create_task(conn, title=title) for title in ("own", "foreign")]
+    for tid in (own, foreign):
+        kb.claim_task(conn, tid)
+    conn.execute("UPDATE tasks SET worker_pid = ? WHERE id = ?", (os.getpid(), own))
+    conn.commit()
+    task = kb.get_task(conn, own)
+    for key, value in {
+        "HERMES_KANBAN_DB": str(db), "HERMES_KANBAN_BOARD": "default",
+        "HERMES_KANBAN_TASK": own, "HERMES_KANBAN_RUN_ID": str(task.current_run_id),
+        "HERMES_KANBAN_CLAIM_LOCK": task.claim_lock, "HOME": str(tmp_path),
+    }.items():
+        monkeypatch.setenv(key, value)
+    for key in (DELEGATED_CHILD_ENV_MARKER, SUPERVISED_TERMINAL_ENV_MARKER, SUPERVISED_WORKER_PID_ENV):
+        monkeypatch.delenv(key, raising=False)
+    return conn, own, foreign
+
+
+def _cli(terminal, *argv):
+    cmd = f"cd {shlex.quote(str(ROOT))} && {shlex.quote(sys.executable)} -m hermes_cli.main kanban " + " ".join(
+        shlex.quote(a) for a in argv)
+    result = terminal.execute(cmd, timeout=60)
+    return int(result.get("returncode", 1) if result.get("returncode") is not None else 1), result.get("output", "")
+
+
+def test_worker_terminal_records_on_its_own_card_and_builds_its_cards_only(tmp_path, monkeypatch):
+    conn, own, foreign = _worker_board(tmp_path, monkeypatch)
+    terminal = LocalEnvironment(cwd=str(tmp_path))
+    try:
+        rc, out = _cli(terminal, "comment", own, "progress from the worker terminal", "--author", "kanban-workflow")
+        assert rc == 0, out
+        rc, out = _cli(terminal, "comment", foreign, "must refuse")
+        assert rc != 0 and "own card" in out, out
+        rc, out = _cli(terminal, "heartbeat", own)
+        assert rc == 0, out
+        # Lifecycle stays in-process: the terminal cannot finish, block or review the card.
+        for action in (["complete", own, "--result", "no"], ["block", own, "no"],
+                       ["request-review", own, "--summary", "no"], ["unblock", own], ["claim", foreign]):
+            rc, out = _cli(terminal, *action)
+            assert rc != 0 and "supervised terminal may not run" in out, (action, out)
+        rc, out = _cli(terminal, "create", "[mac 1] child", "--created-by", "kanban-workflow", "--json")
+        assert rc == 0, out
+        child = json.loads(out[out.index("{"):out.rindex("}") + 1])["id"]
+        rc, out = _cli(terminal, "create", "[round 1] child", "--created-by", "kanban-workflow", "--json")
+        assert rc == 0, out
+        rnd = json.loads(out[out.index("{"):out.rindex("}") + 1])["id"]
+        assert _cli(terminal, "link", child, rnd)[0] == 0           # both created by the worker
+        assert _cli(terminal, "link", own, child)[0] == 0           # own card as parent
+        # A foreign card's graph is never changed from here, in either direction, unless the
+        # worker's own card already gates it (the request's report card, below).
+        rc, out = _cli(terminal, "link", foreign, rnd)
+        assert rc != 0 and "owns or created" in out, out
+        rc, out = _cli(terminal, "link", foreign, own)
+        assert rc != 0 and "owns or created" in out, out
+        rc, out = _cli(terminal, "comment", child, "lane evidence", "--author", "kanban-workflow")
+        assert rc == 0, out
+        other = kb.create_task(conn, title="someone else's")
+        for parent, kid in ((foreign, other), (own, other), (child, other), (other, rnd)):
+            rc, out = _cli(terminal, "link", parent, kid)
+            assert rc != 0 and "owns or created" in out, (parent, kid, out)
+        assert kb.parent_ids(conn, other) == [] and kb.child_ids(conn, other) == []
+        # The report shape: the worker's own card already gates `report`; a card the worker
+        # created may become another parent of it (open_next_round / review in workflow.py).
+        report = kb.create_task(conn, title="report")
+        kb.link_tasks(conn, own, report)
+        rc, out = _cli(terminal, "link", rnd, report)
+        assert rc == 0, out
+        rc, out = _cli(terminal, "link", foreign, report)                # foreign parent: not ours
+        assert rc != 0 and "owns or created" in out, out
+        assert sorted(kb.parent_ids(conn, report)) == sorted([own, rnd])
+        rc, out = _cli(terminal, "comment", other, "no")
+        assert rc != 0, out
+    finally:
+        terminal.cleanup()
+    assert [c.body for c in kb.list_comments(conn, own)] == ["progress from the worker terminal"]
+    assert kb.get_task(conn, own).status == "running" and kb.get_task(conn, foreign).status == "running"
+    assert not kb.list_comments(conn, foreign)
+    created = conn.execute("SELECT payload FROM task_events WHERE task_id = ? AND kind = 'created'", (child,)).fetchone()
+    assert json.loads(created[0])["creator_task_id"] == own
+    assert conn.execute("PRAGMA integrity_check").fetchone()[0] == "ok"
+    conn.close()
+
+
+def test_delegate_child_terminal_and_stale_identity_are_denied(tmp_path, monkeypatch):
+    conn, own, foreign = _worker_board(tmp_path, monkeypatch)
+    terminal = LocalEnvironment(cwd=str(tmp_path))
+    try:
+        with delegated_child_context():
+            rc, out = _cli(terminal, "comment", own, "from a delegate child")
+        assert rc != 0 and "delegate_task child contexts cannot mutate" in out, out
+        # Board says another worker pid owns the run now (stale env after a reclaim).
+        conn.execute("UPDATE tasks SET worker_pid = ? WHERE id = ?", (os.getpid() + 100000, own)); conn.commit()
+        rc, out = _cli(terminal, "comment", own, "stale")
+        assert rc != 0 and "does not match the board" in out, out
+        conn.execute("UPDATE tasks SET worker_pid = ? WHERE id = ?", (os.getpid(), own)); conn.commit()
+        # The run the env names is gone from the board (finished, reclaimed, pruned).
+        run_id = kb.get_task(conn, own).current_run_id
+        conn.execute("UPDATE task_runs SET status = 'released' WHERE id = ?", (run_id,)); conn.commit()
+        rc, out = _cli(terminal, "comment", own, "finished run")
+        assert rc != 0 and "run" in out and "released" in out, out
+        conn.execute("DELETE FROM task_runs WHERE id = ?", (run_id,)); conn.commit()
+        rc, out = _cli(terminal, "comment", own, "missing run")
+        assert rc != 0 and "missing" in out, out
+        conn.execute("INSERT INTO task_runs (id, task_id, status, worker_pid, started_at) VALUES (?, ?, 'running', ?, 1)",
+                     (run_id, own, os.getpid())); conn.commit()
+        # The env names no run at all: the grant needs one.
+        monkeypatch.delenv("HERMES_KANBAN_RUN_ID")
+        rc, out = _cli(terminal, "comment", own, "no run id")
+        assert rc != 0 and "no run id" in out, out
+        monkeypatch.setenv("HERMES_KANBAN_RUN_ID", str(run_id))
+        assert kb.block_task(conn, own, reason="fixture")
+        rc, out = _cli(terminal, "comment", own, "blocked card")
+        assert rc != 0 and "does not match the board" in out, out
+    finally:
+        terminal.cleanup()
+    assert not kb.list_comments(conn, own)
+    conn.close()
+
+
+def _in_process_grant_env(conn, own, monkeypatch):
+    """Make THIS test process look like a supervised terminal of a worker that is our parent."""
+    worker_pid = os.getppid()
+    conn.execute("UPDATE tasks SET worker_pid = ? WHERE id = ?", (worker_pid, own))
+    conn.execute("UPDATE task_runs SET worker_pid = ? WHERE task_id = ?", (worker_pid, own)); conn.commit()
+    monkeypatch.setenv(DELEGATED_CHILD_ENV_MARKER, "1")
+    monkeypatch.setenv(SUPERVISED_TERMINAL_ENV_MARKER, "1")
+    monkeypatch.setenv(SUPERVISED_WORKER_PID_ENV, str(worker_pid))
+    return worker_pid
+
+
+def test_grant_is_reverified_at_the_write_boundary(tmp_path, monkeypatch):
+    """The CLI's precheck is UX; the board state that counts is the one read inside the write
+    transaction: a task that stopped running, changed worker or run, a dead run row, or an
+    expired grant denies there, and nothing is written."""
+    conn, own, foreign = _worker_board(tmp_path, monkeypatch)
+    _in_process_grant_env(conn, own, monkeypatch)
+    with kb.supervised_terminal_mutation():
+        kb.add_comment(conn, own, "t", "granted")
+    assert [c.body for c in kb.list_comments(conn, own)] == ["granted"]
+
+    def denied(setup, undo, needle):
+        setup(); conn.commit()
+        with pytest.raises(PermissionError, match=needle):
+            with kb.supervised_terminal_mutation():
+                kb.add_comment(conn, own, "t", "must not land")
+        undo(); conn.commit()
+        assert [c.body for c in kb.list_comments(conn, own)] == ["granted"]
+
+    run_id = kb.get_task(conn, own).current_run_id
+    # Stale board status between precheck and write.
+    denied(lambda: conn.execute("UPDATE tasks SET status = 'blocked' WHERE id = ?", (own,)),
+           lambda: conn.execute("UPDATE tasks SET status = 'running' WHERE id = ?", (own,)), "is blocked")
+    # Reclaimed by another worker pid.
+    denied(lambda: conn.execute("UPDATE tasks SET worker_pid = worker_pid + 7 WHERE id = ?", (own,)),
+           lambda: conn.execute("UPDATE tasks SET worker_pid = worker_pid - 7 WHERE id = ?", (own,)), "not running under pid")
+    # A newer run owns the task now.
+    denied(lambda: conn.execute("UPDATE tasks SET current_run_id = ? WHERE id = ?", (run_id + 1, own)),
+           lambda: conn.execute("UPDATE tasks SET current_run_id = ? WHERE id = ?", (run_id, own)), "not running under pid")
+    # The run row ended or vanished.
+    denied(lambda: conn.execute("UPDATE task_runs SET status = 'done' WHERE id = ?", (run_id,)),
+           lambda: conn.execute("UPDATE task_runs SET status = 'running' WHERE id = ?", (run_id,)), "is done")
+    saved = conn.execute("SELECT * FROM task_runs WHERE id = ?", (run_id,)).fetchone()
+    cols = [d[1] for d in conn.execute("PRAGMA table_info(task_runs)")]
+    denied(lambda: conn.execute("DELETE FROM task_runs WHERE id = ?", (run_id,)),
+           lambda: conn.execute(f"INSERT INTO task_runs ({', '.join(cols)}) VALUES ({', '.join('?' * len(cols))})",
+                                tuple(saved)), "is missing")
+    # Grant expiry: the context outlived its one command.
+    with pytest.raises(PermissionError, match="expired"):
+        with kb.supervised_terminal_mutation(ttl_seconds=-1):
+            kb.add_comment(conn, own, "t", "late")
+    # No run id in the env: no grant at all.
+    monkeypatch.delenv("HERMES_KANBAN_RUN_ID")
+    with pytest.raises(PermissionError, match="no run id"):
+        with kb.supervised_terminal_mutation():
+            pass
+    monkeypatch.setenv("HERMES_KANBAN_RUN_ID", str(run_id))
+    # The grant never covers board metadata or a foreign task the CLI would have refused.
+    with kb.supervised_terminal_mutation():
+        with pytest.raises(PermissionError, match="task mutations only"):
+            kb.write_board_metadata("default", name="x")
+    assert [c.body for c in kb.list_comments(conn, own)] == ["granted"]
+    assert not kb.list_comments(conn, foreign)
+    conn.close()

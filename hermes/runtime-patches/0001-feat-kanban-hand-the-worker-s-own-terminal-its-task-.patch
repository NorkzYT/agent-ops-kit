-def _assert_not_delegated_child_mutation() -> None:
+# Set only by :func:`supervised_terminal_mutation` after the CLI verified the worker's
+# supervised terminal identity and the scope of the requested mutation. The grant is
+# re-verified against the board inside every write transaction it covers.
+@dataclass(frozen=True)
+class SupervisedTerminalGrant:
+    task_id: str
+    run_id: int
+    worker_pid: int
+    expires_at: float  # time.monotonic() deadline; one CLI command, never a session
+
+
+_SUPERVISED_TERMINAL_GRANT: ContextVar[Optional[SupervisedTerminalGrant]] = ContextVar(
+    "hermes_kanban_supervised_terminal_grant", default=None)
+# A CLI command finishes in seconds; a grant that outlives this is a leaked context, not a command.
+SUPERVISED_TERMINAL_GRANT_TTL_SECONDS = 120.0
+
+
+@contextlib.contextmanager
+def supervised_terminal_mutation(*, ttl_seconds: float = SUPERVISED_TERMINAL_GRANT_TTL_SECONDS):
+    """Grant the fenced process ONE verified board mutation on behalf of the worker whose
+    supervised terminal it runs in (``agent.delegation_context.supervised_terminal_identity``:
+    marker, task id, run id and an ancestor worker pid). The identity is re-verified here and
+    again inside every ``write_txn`` the grant covers (:func:`_verify_supervised_grant`: task
+    ``running`` under that worker pid and run, the run row alive, grant not expired), so an
+    import of this module from an arbitrary fenced child without that identity still fails
+    closed and a board that moved on (reclaim, block, finished run) denies at the write. The
+    run id is mandatory. Which cards the mutation may touch is the CLI's check. Cooperative
+    runtime scoping like the fence itself, not confinement of same-uid code."""
+    try:
+        from agent.delegation_context import supervised_terminal_identity
+
+        ident = supervised_terminal_identity()
+    except Exception:
+        ident = None
+    if ident is None:
+        raise PermissionError("supervised terminal identity could not be verified; refusing to mutate")
+    if ident.run_id is None:
+        raise PermissionError("supervised terminal identity carries no run id; refusing to mutate")
+    grant = SupervisedTerminalGrant(task_id=ident.task_id, run_id=int(ident.run_id), worker_pid=int(ident.worker_pid),
+                                    expires_at=time.monotonic() + float(ttl_seconds))
+    token = _SUPERVISED_TERMINAL_GRANT.set(grant)
+    try:
+        yield ident
+    finally:
+        _SUPERVISED_TERMINAL_GRANT.reset(token)
+
+
+def _verify_supervised_grant(conn: sqlite3.Connection, grant: SupervisedTerminalGrant) -> None:
+    """The board, read inside the write transaction, must still show the grant's task running
+    under the grant's worker pid and run, with that run row alive. Anything else denies."""
+    if time.monotonic() > grant.expires_at:
+        raise PermissionError("supervised terminal grant expired; refusing to mutate")
+    row = conn.execute(
+        "SELECT status, worker_pid, current_run_id FROM tasks WHERE id = ?", (grant.task_id,)).fetchone()
+    if row is None:
+        raise PermissionError(f"supervised terminal grant: task {grant.task_id} is not on this board; refusing to mutate")
+    status, worker_pid, current_run_id = row[0], row[1], row[2]
+    if status != "running" or worker_pid != grant.worker_pid or current_run_id != grant.run_id:
+        raise PermissionError(
+            f"supervised terminal grant: task {grant.task_id} is {status} under pid {worker_pid} run {current_run_id}, "
+            f"not running under pid {grant.worker_pid} run {grant.run_id}; refusing to mutate")
+    run = conn.execute("SELECT status, worker_pid FROM task_runs WHERE id = ? AND task_id = ?",
+                       (grant.run_id, grant.task_id)).fetchone()
+    if run is None or run[0] != "running" or (run[1] is not None and run[1] != grant.worker_pid):
+        raise PermissionError(
+            f"supervised terminal grant: run {grant.run_id} of {grant.task_id} is "
+            f"{'missing' if run is None else run[0]}; refusing to mutate")
+
+
+def _assert_not_delegated_child_mutation(conn: Optional[sqlite3.Connection] = None) -> None:
     """Reject Kanban mutations from ``delegate_task`` child contexts.
 
     The tool/CLI fast-fail guards are UX, not a trust boundary (a child can shell
     out or import this module); the invariant lives here so every ``write_txn``
     user and board-metadata mutator fails closed before touching durable state.
+    The one exception is a mutation the CLI wrapped in
+    :func:`supervised_terminal_mutation` for the worker's own verified terminal: with
+    *conn* (a task-DB write transaction) the grant is re-verified against the board at
+    that moment; without one (board metadata, the current-board pointer) the grant
+    covers nothing and the mutation is denied.
     """
     try:

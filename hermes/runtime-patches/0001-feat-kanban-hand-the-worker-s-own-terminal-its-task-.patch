+IDENTITY_PROBE = (
+    "import json, sys; sys.path.insert(0, %r)\n"
+    "from agent.delegation_context import supervised_terminal_identity\n"
+    "i = supervised_terminal_identity()\n"
+    "print('IDENT=' + json.dumps(None if i is None else list(i)))\n"

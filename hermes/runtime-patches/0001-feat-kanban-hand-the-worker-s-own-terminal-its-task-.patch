+    def test_malformed_or_missing_fields_fail_closed(self, worker_env):
+        base = supervised_worker_terminal_env(dict(os.environ))
+        for broken in ({SUPERVISED_WORKER_PID_ENV: "abc"}, {"HERMES_KANBAN_RUN_ID": "x1"},
+                       {SUPERVISED_TERMINAL_ENV_MARKER: "0"}, {"HERMES_KANBAN_TASK": ""}):
+            env = {**base, **broken, "PATH": os.environ.get("PATH", "")}
+            assert _probe(env) is None, broken

+++ b/tests/tools/test_kanban_supervised_terminal.py
@@ -0,0 +1,236 @@
+"""Supervised worker terminal: the dispatcher-owned worker's OWN terminal keeps its task
+identity (task id, run id, worker pid; never the claim lock) while every other spawn surface,
+delegate_task child and cron run stays a fenced descendant. The CLI grants that terminal a
+narrow, board-verified scope: progress on its own card and the cards it creates; lifecycle
+transitions and foreign cards stay denied."""
+import json
+import os
+from pathlib import Path
+import shlex
+import subprocess
+import sys
+
+import pytest
+
+from agent.delegation_context import (
+    DELEGATED_CHILD_ENV_MARKER, SUPERVISED_TERMINAL_ENV_MARKER, SUPERVISED_WORKER_PID_ENV,
+    delegated_child_context, non_dispatcher_owned_context, supervised_terminal_identity,
+    supervised_worker_terminal_env,
+)
+from hermes_cli import kanban_db as kb
+from hermes_cli.kanban_db_connect import connect
+from tools.environments.local import LocalEnvironment, _make_run_env, hermes_subprocess_env
+
+
+ROOT = Path(__file__).resolve().parents[2]
+WORKER_ENV = {
+    "HERMES_KANBAN_TASK": "t_own", "HERMES_KANBAN_RUN_ID": "41", "HERMES_KANBAN_CLAIM_LOCK": "host:1",
+    "HERMES_KANBAN_DB": "/tmp/board.db", "HERMES_KANBAN_BOARD": "default",
+}
+
+
+@pytest.fixture
+def worker_env(monkeypatch):
+    for key, value in WORKER_ENV.items():
+        monkeypatch.setenv(key, value)
+    for key in (DELEGATED_CHILD_ENV_MARKER, SUPERVISED_TERMINAL_ENV_MARKER, SUPERVISED_WORKER_PID_ENV):
+        monkeypatch.delenv(key, raising=False)
+    return monkeypatch
+
+
+def _fenced_without_identity(env):
+    assert env[DELEGATED_CHILD_ENV_MARKER] == "1"
+    assert "HERMES_KANBAN_TASK" not in env and "HERMES_KANBAN_RUN_ID" not in env
+    assert "HERMES_KANBAN_CLAIM_LOCK" not in env
+    assert SUPERVISED_TERMINAL_ENV_MARKER not in env and SUPERVISED_WORKER_PID_ENV not in env
+
+
+class TestSupervisedEnv:
+    def test_worker_terminal_gets_identity_but_never_the_claim_lock(self, worker_env):
+        env = supervised_worker_terminal_env({**os.environ, "KEEP": "1"})

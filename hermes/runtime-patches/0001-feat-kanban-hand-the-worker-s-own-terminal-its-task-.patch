diff --git a/hermes_cli/kanban_db.py b/hermes_cli/kanban_db.py
index ec7f16f05e..4b17fd14ea 100644
--- a/hermes_cli/kanban_db.py
+++ b/hermes_cli/kanban_db.py
@@ -118,12 +118,42 @@ _IS_WINDOWS = sys.platform == "win32"
 KANBAN_ATTACHMENT_MAX_BYTES = 25 * 1024 * 1024  # one cap for dashboard, tools and CLI
 
 
+# Set only by :func:`supervised_terminal_mutation` after the CLI verified the worker's
+# supervised terminal identity and the scope of the requested mutation.
+_SUPERVISED_TERMINAL_GRANT: ContextVar[bool] = ContextVar("hermes_kanban_supervised_terminal_grant", default=False)
+
+
+@contextlib.contextmanager
+def supervised_terminal_mutation():
+    """Grant the fenced process ONE verified board mutation on behalf of the worker whose
+    supervised terminal it runs in (``agent.delegation_context.supervised_terminal_identity``:
+    marker, task id, run id and an ancestor worker pid). The identity is re-verified here, so
+    an import of this module from an arbitrary fenced child without that identity still
+    fails closed; which cards the mutation may touch is the CLI's check. Cooperative
+    runtime scoping like the fence itself, not confinement of same-uid code."""
+    try:
+        from agent.delegation_context import supervised_terminal_identity
+
+        ident = supervised_terminal_identity()
+    except Exception:
+        ident = None
+    if ident is None:
+        raise PermissionError("supervised terminal identity could not be verified; refusing to mutate")
+    token = _SUPERVISED_TERMINAL_GRANT.set(True)
+    try:
+        yield ident
+    finally:
+        _SUPERVISED_TERMINAL_GRANT.reset(token)
+
+
 def _assert_not_delegated_child_mutation() -> None:
     """Reject Kanban mutations from ``delegate_task`` child contexts.
 
     The tool/CLI fast-fail guards are UX, not a trust boundary (a child can shell
     out or import this module); the invariant lives here so every ``write_txn``
     user and board-metadata mutator fails closed before touching durable state.
+    The one exception is a mutation the CLI wrapped in
+    :func:`supervised_terminal_mutation` for the worker's own verified terminal.
     """
     try:
         from agent.delegation_context import is_delegated_child_process_context
@@ -131,7 +161,7 @@ def _assert_not_delegated_child_mutation() -> None:
         delegated = is_delegated_child_process_context()
     except Exception:
         delegated = bool(os.environ.get("HERMES_DELEGATED_CHILD_CONTEXT"))
-    if delegated:
+    if delegated and not _SUPERVISED_TERMINAL_GRANT.get():
         raise PermissionError("delegate_task child contexts cannot mutate Kanban tasks or boards")
 
 

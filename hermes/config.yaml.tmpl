# ~/.hermes/config.yaml — rendered by scripts/hermes-install.sh from
# hermes/config.yaml.tmpl. Secrets are NOT in this file: they live in
# ~/.hermes/.env and are referenced here as ${VAR}.
#
# Re-render after editing .env:  make hermes-install
# Full reference: https://hermes-agent.nousresearch.com/docs/user-guide/configuration

# ---------------------------------------------------------------- Models ---
# Orchestrator model: ChatGPT subscription through CLIProxyAPI (OpenAI-compatible).
model:
  provider: custom
  default: __HERMES_MODEL__
  base_url: __CLIPROXY_BASE_URL__
  api_key: ${CLIPROXY_API_KEY}

# Subagents spawned with delegate_task (coding work) go to Claude Max through
# claude-max-proxy. `opus`, `sonnet`, `haiku`, `default` or an exact id from
# `make models`. The proxy needs no key; any non-empty string is accepted.
delegation:
  provider: custom
  model: __HERMES_CODING_MODEL__
  base_url: __CLAUDE_MAX_PROXY_BASE_URL__
  api_key: ${CLAUDE_MAX_PROXY_API_KEY}
  api_mode: chat_completions
  max_concurrent_children: 4
  max_spawn_depth: 2
  child_timeout_seconds: 3600
  worktree_isolation: false

# --------------------------------------------------------------- Toolsets ---
toolsets: [hermes-cli]
platform_toolsets:
  cli:
    - web
    - search
    - terminal
    - file
    - browser
    - vision
    - skills
    - todo
    - memory
    - session_search
    - cronjob
    - code_execution
    - delegation
    - clarify
    - kanban
  discord:
    - web
    - search
    - terminal
    - file
    - browser
    - vision
    - skills
    - todo
    - memory
    - session_search
    - cronjob
    - code_execution
    - delegation
    - clarify
    - kanban
    - discord
    - discord_admin

terminal:
  backend: local
  cwd: __REPOS_DIR__
  timeout: 600

# Browser Use is the default browser backend. With BROWSER_USE_API_KEY set in
# .env, sessions run on Browser Use Cloud; otherwise a local Chromium is used.
browser:
  backend: browser-use
  headed: false
  allow_private_urls: true

# ----------------------------------------------------------------- Memory ---
# Built-in MEMORY.md/USER.md stay on; Honcho (self-hosted, see honcho.json)
# provides cross-session user modelling (honcho.json points at the local stack).
memory:
  memory_enabled: true
  user_profile_enabled: true
  provider: honcho
  write_approval: false

# ---------------------------------------------------------------- Discord ---
discord:
  require_mention: true
  thread_require_mention: false
  auto_thread: true
  reactions: true
  history_backfill: true
  allow_mentions:
    everyone: false
    roles: false
    users: true
    replied_user: true
group_sessions_per_user: true

# ----------------------------------------------------------------- Kanban ---
# Shared board for multi-profile teams (docs/profiles-and-teams.md).
kanban:
  dispatch_in_gateway: true
  dispatch_interval_seconds: 60
  max_in_progress: 2

# ------------------------------------------------------------------ Agent ---
agent:
  verify_on_stop: true
  verify_guidance: true

display:
  streaming: true

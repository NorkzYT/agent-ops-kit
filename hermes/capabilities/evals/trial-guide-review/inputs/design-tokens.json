{
  "schema": "design-tokens.v1",
  "product_name": "First-step guide",
  "binding": {
    "task_id": "t-trial-design",
    "company_id": "example-a",
    "project_id": "example-web",
    "data_classification": "synthetic"
  },
  "themes": {
    "light": {
      "bg": "#f7f7f4",
      "surface": "#ffffff",
      "text": "#1f2a37",
      "text-muted": "#4b5563",
      "accent": "#0f766e",
      "on-accent": "#ffffff",
      "border": "#7c8594",
      "focus": "#b45309",
      "success": "#15803d",
      "warning": "#a16207",
      "danger": "#b91c1c",
      "info": "#1d4ed8"
    }
  },
  "spacing_px": [
    4,
    8,
    12,
    16,
    24,
    32,
    48
  ],
  "radius_px": {
    "small": 2,
    "medium": 4,
    "large": 8
  },
  "type": {
    "roles": [
      {
        "role": "display",
        "family": "Source Sans 3",
        "fallback": "sans-serif",
        "weights": [
          600,
          700
        ],
        "verification": "verified"
      },
      {
        "role": "body",
        "family": "Source Sans 3",
        "fallback": "sans-serif",
        "weights": [
          400,
          600
        ],
        "verification": "verified"
      },
      {
        "role": "mono",
        "family": "JetBrains Mono",
        "fallback": "monospace",
        "weights": [
          400
        ],
        "verification": "verified"
      }
    ],
    "base_px": 16,
    "ratio": 1.25,
    "body_line_height": 1.5,
    "measure_ch": 66
  },
  "type_scale_px": [
    16,
    20,
    25,
    31,
    39,
    49
  ],
  "motion": {
    "short_ms": 120,
    "long_ms": 240,
    "enter_easing": "cubic-bezier(0.16, 1, 0.3, 1)",
    "move_easing": "cubic-bezier(0.65, 0, 0.35, 1)"
  },
  "breakpoints": [
    {
      "name": "mobile",
      "min_width_px": 0,
      "columns": 1,
      "navigation": "collapsible-menu",
      "notes": "The guide becomes a full-width sheet above the workspace; actions stack, primary first."
    },
    {
      "name": "tablet",
      "min_width_px": 768,
      "columns": 2,
      "navigation": "top-bar",
      "notes": "The guide docks beside the workspace."
    },
    {
      "name": "desktop",
      "min_width_px": 1024,
      "columns": 2,
      "navigation": "sidebar",
      "notes": "The guide keeps a fixed column; the workspace takes the rest."
    }
  ],
  "max_content_width_px": 1120
}

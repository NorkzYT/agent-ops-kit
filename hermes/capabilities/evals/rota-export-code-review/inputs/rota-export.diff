+"""Export the billing rota for the support lead."""
+import argparse
+import datetime
+import shutil
+import subprocess
+from pathlib import Path
+
+EXPORT_DIR = Path("/srv/rota-exports")
+
+
+def export(team: str, rows: list) -> Path:
+    shutil.rmtree(EXPORT_DIR, ignore_errors=True)
+    EXPORT_DIR.mkdir(parents=True)
+    stamp = datetime.datetime.now().strftime("%Y-%m-%d")
+    out = EXPORT_DIR / f"{team}-{stamp}.csv"
+    out.write_text("\n".join(",".join(r) for r in rows))
+    subprocess.run(f"gzip -f {out}", shell=True, check=True)
+    return out.with_suffix(".csv.gz")
+
+
+if __name__ == "__main__":
+    ap = argparse.ArgumentParser()
+    ap.add_argument("--team", required=True)
+    print(export(ap.parse_args().team, []))

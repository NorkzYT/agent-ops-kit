{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-ops-kit.local/schemas/capabilities/capability-result.schema.json",
  "title": "CapabilityResult v1",
  "description": "What one capability run returns: evidence to verify, never authority to close a task or widen scope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_id",
    "capability_version",
    "source_digest",
    "implementation_digest",
    "mode",
    "task_id",
    "status",
    "summary",
    "artifacts",
    "sources",
    "claims",
    "checks",
    "assumptions",
    "unknowns",
    "decisions",
    "approval_requests",
    "execution_receipt_ref",
    "limitations"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "capability_id": {
      "$ref": "#/$defs/capability_id"
    },
    "capability_version": {
      "$ref": "#/$defs/version"
    },
    "source_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "implementation_digest": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "mode": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "task_id": {
      "$ref": "#/$defs/id"
    },
    "status": {
      "enum": [
        "completed",
        "partial",
        "needs_input",
        "blocked",
        "failed"
      ]
    },
    "summary": {
      "$ref": "#/$defs/text"
    },
    "artifacts": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "kind",
          "digest"
        ],
        "properties": {
          "artifact_id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "$ref": "#/$defs/artifact_kind"
          },
          "digest": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "kind",
          "ref"
        ],
        "properties": {
          "source_id": {
            "$ref": "#/$defs/id"
          },
          "kind": {
            "enum": [
              "primary-web",
              "document",
              "dataset",
              "artifact",
              "synthetic-fixture"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "retrieved_at": {
            "$ref": "#/$defs/timestamp"
          },
          "digest": {
            "$ref": "#/$defs/sha256"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claim_id",
          "text",
          "classification",
          "source_ids"
        ],
        "properties": {
          "claim_id": {
            "$ref": "#/$defs/id"
          },
          "text": {
            "$ref": "#/$defs/text"
          },
          "classification": {
            "enum": [
              "observed",
              "assumption",
              "hypothesis",
              "estimate",
              "unknown",
              "synthetic"
            ]
          },
          "source_ids": {
            "type": "array",
            "maxItems": 16,
            "items": {
              "$ref": "#/$defs/id"
            },
            "uniqueItems": true
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    },
    "assumptions": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "unknowns": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "scope_consumed": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "minutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10080
        },
        "children": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "spend_usd": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "approval_requests": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "target_ref",
          "reason"
        ],
        "properties": {
          "action": {
            "enum": [
              "external-research-if-private-context",
              "source-modification",
              "commit-push",
              "issue-publication",
              "paid-generation",
              "publication",
              "outreach",
              "spend",
              "browser-login",
              "outside-model-review"
            ]
          },
          "target_ref": {
            "$ref": "#/$defs/ref"
          },
          "reason": {
            "$ref": "#/$defs/short"
          }
        }
      }
    },
    "execution_receipt_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "limitations": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/text"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$"
    },
    "ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}:[A-Za-z0-9][A-Za-z0-9_./:-]{0,159}$",
      "description": "Opaque handle (scheme:id) resolved only by a trusted broker; never a secret, path or URL with credentials."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^(kit|pm|gstack|existing)\\.[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "short": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "artifact_kind": {
      "enum": [
        "task-envelope",
        "evidence-index",
        "feature-brief",
        "problem-brief",
        "decision-brief",
        "one-page-prd",
        "discovery-brief",
        "assumption-register",
        "experiment-plan",
        "opportunity-brief",
        "lean-prd",
        "acceptance-map",
        "implementation-handoff",
        "spec",
        "eng-review",
        "design-brief",
        "design-plan-review",
        "design-package",
        "design-review-report",
        "review-report",
        "qa-report",
        "competitor-report",
        "evidence-ledger",
        "positioning-brief",
        "marketing-plan",
        "process-assessment",
        "pilot-plan",
        "code-change-handoff",
        "ui-evidence"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "check_id",
        "subject",
        "method",
        "environment_ref",
        "status",
        "exit_code",
        "counts",
        "classification",
        "no_claim"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/id"
        },
        "check_id": {
          "$ref": "#/$defs/id"
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "capability_id": {
              "$ref": "#/$defs/capability_id"
            },
            "artifact_id": {
              "$ref": "#/$defs/id"
            },
            "source_digest": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "dimension": {
          "enum": [
            "defined",
            "installed",
            "learned_current",
            "tools_available",
            "authorized",
            "runtime_accepted",
            "executed",
            "outcome_verified"
          ]
        },
        "input_digests": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "method": {
          "enum": [
            "command",
            "observation",
            "read-back",
            "review",
            "fixture"
          ]
        },
        "method_detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "description": "Human-readable description only; never executed."
        },
        "environment_ref": {
          "$ref": "#/$defs/ref"
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "ended_at": {
          "$ref": "#/$defs/timestamp"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "error",
            "skipped",
            "not-run"
          ]
        },
        "exit_code": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": -255,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "passed",
            "failed",
            "errors",
            "skipped"
          ],
          "properties": {
            "passed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            },
            "errors": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            },
            "skipped": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            }
          }
        },
        "artifact_ref": {
          "$ref": "#/$defs/ref"
        },
        "classification": {
          "enum": [
            "observed",
            "reported",
            "simulated",
            "fixture"
          ]
        },
        "no_claim": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    }
  }
}

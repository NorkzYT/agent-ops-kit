{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-ops-kit.local/schemas/capabilities/activation-manifest.schema.json",
  "title": "Capability activation manifest v1",
  "description": "Exact selected files proposed for one Hermes home: source path, relative destination, SHA-256, size and mode. A proposal, not an approval or an installation record; grants nothing.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "status", "target", "skills", "capability_ids", "source_root", "prerequisites",
               "excluded", "config_impact", "files", "bundle_digest"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "capability-activation-manifest"},
    "status": {"type": "string", "maxLength": 120},
    "target": {"type": "string", "maxLength": 200},
    "skills": {"type": "array", "maxItems": 32, "uniqueItems": true,
               "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"}},
    "capability_ids": {"type": "array", "maxItems": 32, "uniqueItems": true,
                       "items": {"type": "string", "pattern": "^(kit|pm|gstack|existing)\\.[a-z0-9]+(-[a-z0-9]+)*$"}},
    "source_root": {"type": "object", "additionalProperties": false, "required": ["destination", "contract"],
                    "properties": {"destination": {"const": "agent-ops-kit/capability-root"},
                                   "contract": {"type": "string", "maxLength": 400}}},
    "prerequisites": {"type": "object", "additionalProperties": false, "required": ["python", "jsonschema"],
                      "properties": {
                        "python": {"type": "string", "maxLength": 20},
                        "jsonschema": {"type": "object", "additionalProperties": false, "required": ["range", "resolved", "install"],
                                       "properties": {
                                         "range": {"type": "string", "maxLength": 40},
                                         "resolved": {"type": "array", "minItems": 1, "maxItems": 4, "items": {
                                           "type": "object", "additionalProperties": false,
                                           "required": ["interpreter", "python", "jsonschema", "source"],
                                           "properties": {"interpreter": {"type": "string", "maxLength": 200},
                                                          "python": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
                                                          "jsonschema": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
                                                          "source": {"type": "string", "maxLength": 200}}}},
                                         "install": {"type": "string", "maxLength": 200}}}}},
    "excluded": {"type": "array", "maxItems": 16, "items": {"type": "string", "maxLength": 200}},
    "config_impact": {"type": "string", "maxLength": 400},
    "files": {"type": "array", "minItems": 1, "maxItems": 400, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "destination", "role", "sha256", "size", "mode", "capability_ids"],
      "properties": {
        "source": {"$ref": "#/$defs/relpath"},
        "destination": {"$ref": "#/$defs/relpath"},
        "role": {"enum": ["skill", "capability-root"]},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "size": {"type": "integer", "minimum": 0, "maximum": 2097152},
        "mode": {"const": "0644"},
        "capability_ids": {"type": "array", "maxItems": 16, "uniqueItems": true,
                           "items": {"type": "string", "pattern": "^(kit|pm|gstack|existing)\\.[a-z0-9]+(-[a-z0-9]+)*$"}}}}},
    "bundle_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "relpath": {"type": "string", "maxLength": 200, "pattern": "^(?!/)(?!.*(^|/)\\.\\.(/|$))[A-Za-z0-9_.\\-/]+$"}
  }
}

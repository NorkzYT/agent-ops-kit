{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-ops-kit.local/schemas/capabilities/evidence.schema.json",
  "title": "Evidence v1 index",
  "description": "Check/observation records. A record is evidence to evaluate, never a status by itself: skipped, zero-count, nonzero-exit, simulated, reported or fixture records never become a pass.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "evidence": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "$ref": "#/$defs/evidence"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$"
    },
    "ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}:[A-Za-z0-9][A-Za-z0-9_./:-]{0,159}$",
      "description": "Opaque handle (scheme:id) resolved only by a trusted broker; never a secret, path or URL with credentials."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^(kit|pm|gstack|existing)\\.[a-z0-9]+(-[a-z0-9]+)*$",
      "maxLength": 64
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_id",
        "check_id",
        "subject",
        "method",
        "environment_ref",
        "status",
        "exit_code",
        "counts",
        "classification",
        "no_claim"
      ],
      "properties": {
        "evidence_id": {
          "$ref": "#/$defs/id"
        },
        "check_id": {
          "$ref": "#/$defs/id"
        },
        "subject": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "capability_id": {
              "$ref": "#/$defs/capability_id"
            },
            "artifact_id": {
              "$ref": "#/$defs/id"
            },
            "source_digest": {
              "$ref": "#/$defs/sha256"
            }
          }
        },
        "dimension": {
          "enum": [
            "defined",
            "installed",
            "learned_current",
            "tools_available",
            "authorized",
            "runtime_accepted",
            "executed",
            "outcome_verified"
          ]
        },
        "input_digests": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/sha256"
          }
        },
        "method": {
          "enum": [
            "command",
            "observation",
            "read-back",
            "review",
            "fixture"
          ]
        },
        "method_detail": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "description": "Human-readable description only; never executed."
        },
        "environment_ref": {
          "$ref": "#/$defs/ref"
        },
        "started_at": {
          "$ref": "#/$defs/timestamp"
        },
        "ended_at": {
          "$ref": "#/$defs/timestamp"
        },
        "status": {
          "enum": [
            "passed",
            "failed",
            "error",
            "skipped",
            "not-run"
          ]
        },
        "exit_code": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": -255,
              "maximum": 255
            },
            {
              "type": "null"
            }
          ]
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "passed",
            "failed",
            "errors",
            "skipped"
          ],
          "properties": {
            "passed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            },
            "failed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            },
            "errors": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            },
            "skipped": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000000
            }
          }
        },
        "artifact_ref": {
          "$ref": "#/$defs/ref"
        },
        "classification": {
          "enum": [
            "observed",
            "reported",
            "simulated",
            "fixture"
          ]
        },
        "no_claim": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      }
    }
  }
}

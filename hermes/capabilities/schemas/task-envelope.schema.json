{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-ops-kit.local/schemas/capabilities/task-envelope.schema.json",
  "title": "TaskEnvelope v1",
  "description": "Binding of one task to requester, company/project, destination, data class, inputs and acceptance. Carries references only: no secrets, no permissions, no readiness or boundary-acceptance claims (unknown fields are rejected).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "request_id",
    "requester_ref",
    "destination_ref",
    "company_id",
    "project_id",
    "companies_involved",
    "intent",
    "requested_outcome",
    "data_classification",
    "egress_class",
    "input_artifacts",
    "acceptance_criteria",
    "workflow_version",
    "recovery_generation"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "task_id": {
      "$ref": "#/$defs/id"
    },
    "request_id": {
      "$ref": "#/$defs/id"
    },
    "requester_ref": {
      "$ref": "#/$defs/ref"
    },
    "destination_ref": {
      "$ref": "#/$defs/ref"
    },
    "company_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/tenant"
        },
        {
          "type": "null"
        }
      ]
    },
    "project_id": {
      "oneOf": [
        {
          "$ref": "#/$defs/tenant"
        },
        {
          "type": "null"
        }
      ]
    },
    "companies_involved": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/tenant"
      },
      "uniqueItems": true
    },
    "intent": {
      "$ref": "#/$defs/short"
    },
    "requested_outcome": {
      "$ref": "#/$defs/text"
    },
    "data_classification": {
      "$ref": "#/$defs/data_class"
    },
    "egress_class": {
      "enum": [
        "deny",
        "public-read"
      ]
    },
    "input_artifacts": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/digest_ref"
      }
    },
    "allowed_repository_ids": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/id"
      },
      "uniqueItems": true
    },
    "approval_receipt_refs": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "$ref": "#/$defs/ref"
      },
      "uniqueItems": true
    },
    "acceptance_criteria": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "workflow_version": {
      "$ref": "#/$defs/version"
    },
    "required_platform_lanes": {
      "type": "array",
      "maxItems": 5,
      "items": {
        "enum": [
          "linux",
          "mac",
          "windows",
          "ios",
          "android"
        ]
      },
      "uniqueItems": true
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "max_minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10080
        },
        "max_children": {
          "type": "integer",
          "minimum": 0,
          "maximum": 15
        },
        "max_spend_usd": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "deadline": {
      "$ref": "#/$defs/timestamp"
    },
    "recovery_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,79}$"
    },
    "tenant": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,47}$"
    },
    "ref": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,31}:[A-Za-z0-9][A-Za-z0-9_./:-]{0,159}$",
      "description": "Opaque handle (scheme:id) resolved only by a trusted broker; never a secret, path or URL with credentials."
    },
    "short": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "data_class": {
      "enum": [
        "public",
        "synthetic",
        "company-private"
      ]
    },
    "digest_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "digest"
      ],
      "properties": {
        "artifact_id": {
          "$ref": "#/$defs/id"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]{1,3}\\.[0-9]{1,3}\\.[0-9]{1,3}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,6})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}

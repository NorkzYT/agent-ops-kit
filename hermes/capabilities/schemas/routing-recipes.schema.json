{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-ops-kit.local/schemas/capabilities/routing-recipes.schema.json",
  "title": "Capability routing recipes v1",
  "description": "Smallest useful capability sets per example outcome. Classifier examples and evaluation expectations only; not a router, scheduler or permission.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "description", "recipes"],
  "properties": {
    "schema_version": {"const": 1},
    "description": {"type": "string", "minLength": 1, "maxLength": 400},
    "recipes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["recipe_id", "outcome", "capability_ids", "never", "note"],
        "properties": {
          "recipe_id": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 48},
          "outcome": {"type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^\\n\\r]+$"},
          "capability_ids": {"type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
                             "items": {"$ref": "#/$defs/capability_id"}},
          "never": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/capability_id"}},
          "note": {"type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\n\\r]+$"}
        }
      }
    }
  },
  "$defs": {
    "capability_id": {"type": "string", "pattern": "^(kit|pm|gstack|existing)\\.[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 64}
  }
}

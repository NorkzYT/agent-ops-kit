+def _call(task=TASK, **kw):
+    from agent.auxiliary_client import call_llm
+    return call_llm(task, messages=copy.deepcopy(MESSAGES), timeout=5, **kw)
+
+
+def _acall(task=TASK, **kw):
+    from agent.auxiliary_client import async_call_llm
+    return asyncio.run(async_call_llm(task, messages=copy.deepcopy(MESSAGES), timeout=5, **kw))

+def _scoped_dispatch_probe(record):
+    from agent import relay_llm
+
+    def run_conversation(*_a, **_k):
+        try:
+            relay_llm.execute({"model": "gpt-4o"}, lambda r: record.append(("sent", r["model"])),
+                              name="p", model_name="gpt-4o")
+        except AuxiliaryModelFloorRefused as exc:
+            record.append(("refused", exc.site))
+        return {"final_response": ""}
+    return run_conversation

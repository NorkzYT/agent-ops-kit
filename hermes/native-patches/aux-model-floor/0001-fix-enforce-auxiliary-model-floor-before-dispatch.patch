+++ b/agent/aux_model_floor.py
@@ -0,0 +1,237 @@
+"""Opt-in GPT model floor for auxiliary and side-channel provider attempts.
+
+Off by default (``auxiliary.gpt_model_floor: false``). When a profile's
+``config.yaml`` sets it to ``true``, every guarded provider attempt calls
+:func:`enforce_model_floor` with the exact model id that is about to go on
+the wire, immediately before dispatch. A refused attempt raises
+:class:`AuxiliaryModelFloorRefused`, a permanent error: no same-provider
+retry, no parameter rung, no provider fallback, and no request is sent.
+
+Grammar (kept identical to agent-ops-kit ``scripts/lib/model_floor.py``):
+
+* ``eligible`` -- GPT family id ``gpt-<major>[.<minor>]-<family>`` with
+  family Terra, Sol or Astra and version >= 6.1, bare or behind plain
+  provider wrappers (``openai/``, ``openrouter/openai/``, ``azure:``).
+  Passed through unchanged: the id is never rewritten or upgraded.
+* ``below`` -- strict GPT id older than 6.1, or Luna (or bare ``luna``).
+* ``unknown`` -- names a GPT model but is not a strict family id
+  (``gpt-4o``, ``GPT-6.1-terra``, ``gpt-6.1-terra:latest``, ``chatgpt-4o``).
+* ``other`` -- not an OpenAI GPT id (Claude, Ollama/OSS such as
+  ``gpt-oss:20b``, ``gpt4all``, ``qwen3:8b``): outside the floor.
+
+``below`` and ``unknown`` are refused; so is a missing/empty/non-string
+attempt model while the floor is on (the attempt cannot be classified).
+
+Where the check runs: on the request the provider callback actually
+receives -- after Relay interception and LLM execution middleware may have
+rewritten it -- never only on the pre-interception request. Auxiliary and
+iteration-summary callbacks are wrapped with :func:`guard_dispatch`;
+full-agent forks that consume auxiliary config (background review, curator,
+plugin side questions) run under :func:`floor_scope`, which
+:func:`check_scoped_dispatch` (called from every ``relay_llm`` dispatch
+point and the agent's own provider callback) enforces. A fork whose turn runs
+in the ``codex app-server`` subprocess (no Hermes provider request) is checked
+by :func:`check_scoped_runtime_model` on the exact model id handed to codex,
+before the subprocess is spawned and again at ``turn/start``. The on/off
+decision is taken once, in the caller's profile scope, and carried to the dispatch.
+"""
+
+from __future__ import annotations
+
+import contextlib
+import contextvars
+import logging
+import re
+from typing import Any, Callable, Iterator, Optional
+
+logger = logging.getLogger(__name__)
+
+CONFIG_KEY = "gpt_model_floor"  # auxiliary.gpt_model_floor
+MIN_VERSION = (6, 1)
+ELIGIBLE_FAMILIES = ("terra", "sol", "astra")
+
+_ID_RE = re.compile(r"gpt-(0|[1-9][0-9]{0,2})(?:\.(0|[1-9][0-9]{0,2}))?-(luna|terra|sol|astra)")
+_GPT_LIKE_RE = re.compile(
+    r"gpt[-_. ]?[0-9](?!all)|gpt[-_](?:luna|terra|sol|astra|latest|turbo|default|mini|nano|pro)(?![a-z])",
+    re.IGNORECASE)
+_SEGMENT_SPLIT_RE = re.compile(r"[/:]")
+_WRAPPER_RE = re.compile(r"[A-Za-z0-9][A-Za-z0-9_.-]*")
+_BELOW_FLOOR_ALIASES = frozenset({"luna"})
+_OFF_STRINGS = frozenset({"", "false", "off", "no", "0"})
+
+
+class AuxiliaryModelFloorRefused(RuntimeError):
+    """Permanent refusal of one provider attempt by the opt-in GPT model floor.
+
+    Never transient: recovery paths re-raise it instead of retrying or
+    falling back. ``reason`` is ``below``, ``unknown`` or ``missing_model``."""
+
+    permanent = True
+
+    def __init__(self, model: Any, reason: str, site: str):
+        self.model = model
+        self.reason = reason
+        self.site = site
+        super().__init__(
+            f"model floor refused {site} attempt: model={model!r} ({reason}); "
+            "requires GPT 6.1+ Terra/Sol/Astra or a non-GPT model")
+
+
+def _parse(model_id: str) -> Optional[tuple[str, tuple[int, int]]]:
+    m = _ID_RE.fullmatch(model_id)
+    if m is None:
+        return None
+    return m.group(3), (int(m.group(1)), int(m.group(2) or 0))
+
+
+def floor_status(model_id: object) -> str:
+    """``eligible`` | ``below`` | ``unknown`` | ``other`` (see module doc)."""
+    if not isinstance(model_id, str) or not model_id.strip():
+        return "other"
+    stripped = model_id.strip()
+    if model_id != stripped:
+        shaped = _GPT_LIKE_RE.search(stripped) or stripped.lower() in _BELOW_FLOOR_ALIASES
+        return "unknown" if shaped else "other"
+    if model_id.lower() in _BELOW_FLOOR_ALIASES:
+        return "below"
+    segments = _SEGMENT_SPLIT_RE.split(model_id)
+    if not any(_GPT_LIKE_RE.search(s) for s in segments):
+        return "other"
+    *wrappers, bare = segments
+    parsed = _parse(bare)
+    if parsed is None or not all(_WRAPPER_RE.fullmatch(w) and not _GPT_LIKE_RE.search(w) for w in wrappers):
+        return "unknown"
+    return "eligible" if parsed[0] in ELIGIBLE_FAMILIES and parsed[1] >= MIN_VERSION else "below"
+
+
+def floor_enabled() -> bool:
+    """Read ``auxiliary.gpt_model_floor`` from the active profile's config at call time.
+
+    Reading per attempt (not per turn) covers turnless callers (cron, gateway
+    background work) and follows the context-local ``HERMES_HOME`` override.
+    A successfully read config with the key missing/``false``/``null`` is off
+    (upstream default). Any other value -- ``true`` or a malformed value
+    someone wrote on purpose -- is on. A config that could NOT be read (the
+    reader raised, or served its ``FailedConfigRead`` defaults stand-in) is
+    treated as on: the policy cannot be shown to be disabled, so it fails
+    closed (non-GPT and eligible ids still pass)."""
+    try:
+        from hermes_cli.config import cfg_get, load_config_readonly
+        cfg = load_config_readonly()
+    except Exception:
+        logger.warning("model floor: config read failed; enforcing the floor (fail closed)", exc_info=True)
+        return True
+    if _is_failed_read(cfg):
+        logger.warning("model floor: config.yaml unreadable (defaults stand-in); enforcing the floor (fail closed)")
+        return True
+    value = cfg_get(cfg, "auxiliary", CONFIG_KEY)
+    if value is None or value is False:
+        return False
+    if isinstance(value, str) and value.strip().lower() in _OFF_STRINGS:
+        return False
+    return True
+
+
+def _is_failed_read(cfg: Any) -> bool:
+    try:
+        from hermes_cli.config_read_errors import FailedConfigRead
+    except Exception:  # pragma: no cover - import guard
+        return False
+    return isinstance(cfg, FailedConfigRead)
+
+
+def request_model(request: Any) -> Any:
+    """The wire model id of one provider request (``model``; Bedrock Converse ``modelId``)."""
+    if not isinstance(request, dict):
+        return None
+    return request["model"] if "model" in request else request.get("modelId")
+
+
+def _check(model: Any, site: str) -> None:
+    if not isinstance(model, str) or not model.strip():
+        raise AuxiliaryModelFloorRefused(model, "missing_model", site)
+    status = floor_status(model)
+    if status in ("below", "unknown"):
+        raise AuxiliaryModelFloorRefused(model, status, site)
+
+
+def refuses(model: Any) -> bool:
+    """True when the floor is on and would refuse ``model`` (pre-selection filter for fallbacks)."""
+    if not floor_enabled():
+        return False
+    try:
+        _check(model, "selection")
+    except AuxiliaryModelFloorRefused:
+        return True
+    return False
+
+
+def enforce_model_floor(model: Any, *, site: str) -> None:
+    """Check one attempt's wire model id now (reads the profile config);
+    raises :class:`AuxiliaryModelFloorRefused`. Only for call sites with no
+    later interception between this check and the provider."""
+    if floor_enabled():
+        _check(model, site)
+
+
+def guard_dispatch(callback: Callable[[Any], Any], *, site: str) -> Callable[[Any], Any]:
+    """Wrap a provider callback so the floor checks the request it actually receives.
+
+    The on/off decision is read NOW, in the caller's profile scope; the model
+    check runs at dispatch on the (possibly Relay-rewritten) request. Works
+    for sync callbacks and for callbacks returning an awaitable (the check
+    raises before the coroutine is created)."""
+    if not floor_enabled():
+        return callback
+
+    def guarded(request: Any, *args: Any, **kwargs: Any) -> Any:
+        _check(request_model(request), site)
+        return callback(request, *args, **kwargs)
+
+    return guarded
+
+
+_SCOPE: contextvars.ContextVar[Optional[str]] = contextvars.ContextVar("aux_model_floor_scope", default=None)
+
+
+@contextlib.contextmanager
+def floor_scope(site: str) -> Iterator[bool]:
+    """Run a full-agent fork (background review, curator, side question) under the floor.
+
+    Decides on/off once in the caller's profile scope; while active, every
+    provider dispatch that reaches :func:`check_scoped_dispatch` in this
+    context (and context-copying worker threads) is checked. Yields whether
+    the floor is on."""
+    enabled = floor_enabled()
+    token = _SCOPE.set(site if enabled else None)
+    try:
+        yield enabled
+    finally:
+        _SCOPE.reset(token)
+
+
+def check_scoped_dispatch(request: Any) -> None:
+    """Enforce the floor on ``request`` iff a :func:`floor_scope` is active. No-op otherwise."""
+    site = _SCOPE.get()
+    if site is not None:
+        _check(request_model(request), site)
+
+
+def check_scoped_runtime_model(model: Any, *, runtime: str) -> None:
+    """Enforce the floor on a bare wire ``model`` iff a :func:`floor_scope` is active. No-op otherwise.
+
+    For runtimes that never build a provider request in Hermes (the ``codex app-server`` subprocess
+    owns its own dispatch): ``model`` must be the exact id handed to that runtime. A missing id means
+    the runtime would pick its own default, which Hermes cannot inspect, so it is refused."""
+    site = _SCOPE.get()
+    if site is not None:
+        _check(model, f"{site}:{runtime}")
+
+
+def scoped_floor_active() -> bool:
+    """True when the current context runs under an enabled :func:`floor_scope`."""
+    return _SCOPE.get() is not None
+
+
+def is_floor_refusal(exc: BaseException) -> bool:
+    return isinstance(exc, AuxiliaryModelFloorRefused)

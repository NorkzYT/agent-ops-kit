+# ── missing attempt model fails closed at each relay seam ─────────────────────────────────
+
+
+class _CountingClient:
+    def __init__(self):
+        self.calls = 0
+        self.base_url = "http://127.0.0.1:9/v1"
+        self.api_key = "k"
+        outer = self
+
+        class _Completions:
+            def create(self, **kwargs):
+                outer.calls += 1
+                raise AssertionError("dispatched")
+        self.chat = SimpleNamespace(completions=_Completions())
+
+
+@pytest.mark.parametrize("kwargs", [{}, {"model": ""}, {"model": None}, {"model": "   "}])
+def test_missing_model_refused_at_every_relay_seam(profile, kwargs):
+    from agent import auxiliary_client as ac
+    configure, _, _ = profile
+    configure(floor=True, model="qwen3:8b")
+    request = {"messages": copy.deepcopy(MESSAGES), **kwargs}
+    client = _CountingClient()
+
+    with pytest.raises(AuxiliaryModelFloorRefused) as info:
+        ac._relay_sync_completion(client, dict(request), create=lambda r: client.chat.completions.create(**r))
+    assert info.value.reason == "missing_model"
+    with pytest.raises(AuxiliaryModelFloorRefused):
+        ac._relay_sync_stream(client, dict(request))
+
+    async def _acreate(r):
+        return client.chat.completions.create(**r)
+    with pytest.raises(AuxiliaryModelFloorRefused):
+        asyncio.run(ac._relay_async_completion(client, dict(request), create=_acreate))
+    assert client.calls == 0
+
+
+def test_missing_model_allowed_when_floor_off(profile):
+    from agent import auxiliary_client as ac
+    configure, _, _ = profile
+    configure(floor=False, model="qwen3:8b")
+    client = _CountingClient()
+    with pytest.raises(AssertionError, match="dispatched"):
+        ac._relay_sync_completion(client, {"messages": copy.deepcopy(MESSAGES)},
+                                  create=lambda r: client.chat.completions.create(**r))
+    assert client.calls == 1

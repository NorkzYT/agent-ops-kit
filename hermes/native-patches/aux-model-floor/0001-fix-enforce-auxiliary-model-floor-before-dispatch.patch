+def test_per_profile_and_turnless_background_thread(tmp_path, monkeypatch, endpoint):
+    from agent.auxiliary_client import shutdown_cached_clients
+    base_url, requests = endpoint
+    on, off = tmp_path / "profile-on", tmp_path / "profile-off"
+    _write_profile(on, base_url, floor=True, model="gpt-4o")
+    _write_profile(off, base_url, floor=False, model="gpt-4o")
+    outcome = {}
+
+    def _turnless(home, key):
+        # No main_runtime, no agent/turn context: a cron-style background call.
+        monkeypatch.setenv("HERMES_HOME", str(home))
+        shutdown_cached_clients()
+        try:
+            _call()
+            outcome[key] = "sent"
+        except AuxiliaryModelFloorRefused:
+            outcome[key] = "refused"
+
+    for home, key in ((on, "on"), (off, "off"), (on, "on-again")):
+        t = threading.Thread(target=_turnless, args=(home, key))
+        t.start()
+        t.join(30)
+    assert outcome == {"on": "refused", "off": "sent", "on-again": "refused"}
+    assert [p["model"] for _, p in requests] == ["gpt-4o"]

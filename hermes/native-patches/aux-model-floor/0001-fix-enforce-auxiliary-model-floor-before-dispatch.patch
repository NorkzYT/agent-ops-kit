+def test_dispatch_refused_modelless_entry_is_not_reselected(profile, monkeypatch, asynchronous):
+    """Walk identity: the dispatch-time refusal recorded the resolved id while the entry's configured
+    model is empty; the re-walk must still skip that entry and reach the next one (not re-select the

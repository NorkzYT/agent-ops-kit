+"""Opt-in GPT model floor (``auxiliary.gpt_model_floor``) at the real provider-attempt seams.
+
+Every dispatch goes to a local HTTP endpoint (or a counting fake transport for the agent-level
+paths) so a refusal is proven by *zero* recorded requests, and an allowed id by the exact wire
+``model`` field. No real model is called.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import copy
+import json
+import threading
+from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import pytest
+import hermes_yaml as yaml
+
+from agent.aux_model_floor import AuxiliaryModelFloorRefused, floor_status
+
+MESSAGES = [{"role": "user", "content": "say ok"}]
+
+REFUSED = [
+    "gpt-4o", "gpt-4.1-mini", "gpt-5.5", "gpt-6.0-terra", "gpt-6-terra", "gpt-6.1-luna", "gpt-6.2-luna",
+    "GPT-6.1-terra", "gpt-6.1-terra:latest", "gpt-6-1-terra", "chatgpt-4o-latest", "openai/gpt-5.5",
+    "openrouter/openai/gpt-6.0-sol", "azure-gpt-4o", "gpt-latest", "luna", " gpt-6.1-terra",
+]
+ALLOWED_GPT = ["gpt-6.1-terra", "gpt-6.2-sol", "gpt-6.3-astra", "gpt-7-terra", "openai/gpt-6.1-terra",
+               "openrouter/openai/gpt-6.2-sol", "azure:gpt-6.1-terra"]
+ALLOWED_OTHER = ["claude-sonnet-5-5", "anthropic/claude-opus-5-5", "gpt-oss:20b", "gpt4all-j", "qwen3:8b",
+                 "llama3.1:8b", "ollama/luna", "mistral-small"]
+

+@patch("agent.process_bootstrap.OpenAI")
+@pytest.mark.parametrize("model,floor,sent", [
+    ("openai/gpt-4o", True, False), ("openai/gpt-6.1-terra", True, True),
+    ("anthropic/claude-sonnet-5-5", True, True), ("openai/gpt-4o", False, True),
+])
+def test_iteration_summary_floor(_openai, tmp_path, monkeypatch, model, floor, sent):

+TASK = "title_generation"
+
+
+def _write_profile(home, base_url, *, floor, model, task=TASK, fallback=None, api_mode=None, retries=0):
+    task_cfg = {"provider": "custom", "model": model, "base_url": base_url + "/v1"}
+    if api_mode:
+        task_cfg["api_mode"] = api_mode
+        task_cfg["base_url"] = base_url
+    if fallback is not None:
+        # ``None`` = an entry without ``model``: the provider's default model.
+        task_cfg["fallback_chain"] = [
+            {"provider": "custom", **({"model": m} if m is not None else {}),
+             "base_url": base_url.replace("127.0.0.1", "localhost") + "/v1"}
+            for m in fallback]
+    auxiliary = {"transient_retries": retries, task: task_cfg}
+    if floor is not None:
+        auxiliary["gpt_model_floor"] = floor
+    config = {"model": {"provider": "custom", "default": "main-model", "base_url": base_url + "/v1"},
+              "auxiliary": auxiliary}
+    home.mkdir(parents=True, exist_ok=True)
+    (home / "config.yaml").write_text(yaml.safe_dump(config), encoding="utf-8")
+

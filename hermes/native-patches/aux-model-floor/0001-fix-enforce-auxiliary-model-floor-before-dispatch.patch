+def _managed_attempt(request):
+    import contextvars
+    from agent import relay_llm
+    attempt = object.__new__(relay_llm._ManagedAttempt)
+    attempt.request, attempt.metadata = request, None
+    attempt.body = relay_llm._relay_request_body(request, None)
+    attempt.codec_baseline = copy.deepcopy(attempt.body)
+    attempt.raw_response = {}
+    attempt.context = contextvars.copy_context()
+    return attempt
+
+
+@pytest.mark.parametrize("floor", [True, False])
+def test_relay_managed_attempt_checks_intercepted_request(tmp_path, monkeypatch, floor):
+    from agent.aux_model_floor import floor_scope
+    _floor_home(tmp_path, monkeypatch, floor)
+    sent = []
+    with floor_scope("background_review"):
+        attempt = _managed_attempt({"model": "gpt-6.1-terra", "messages": copy.deepcopy(MESSAGES)})
+    # Relay intercept rewrote the model; the provider callback would receive gpt-4o.
+    rewritten = SimpleNamespace(content={"model": "gpt-4o", "messages": copy.deepcopy(MESSAGES)})
+    if floor:
+        with pytest.raises(AuxiliaryModelFloorRefused) as info:
+            attempt.invoke(lambda r: sent.append(r) or {"ok": True}, rewritten)
+        assert info.value.site == "background_review"
+        assert attempt.raw_response["error"] is info.value  # resolve_failure re-raises it as the callback error
+        assert sent == []
+    else:
+        attempt.invoke(lambda r: sent.append(r) or {"ok": True}, rewritten)
+        assert [r["model"] for r in sent] == ["gpt-4o"]
+

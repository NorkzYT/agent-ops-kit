+    def perform(step):
+        raise AuxiliaryModelFloorRefused("gpt-4o", "unknown", "test")
+
+    async def aperform(step):
+        perform(step)
+
+    original = RuntimeError("HTTP 400 unsupported_parameter temperature")
+    with pytest.raises(RuntimeError) as info:
+        if asynchronous:
+            asyncio.run(_drive_ladder_async(ladder(), aperform, original=original))
+        else:
+            _drive_ladder(ladder(), perform, original=original)
+    assert seen == []
+    # the rung's refusal ends recovery with the error that started it
+    assert info.value is original
+    assert isinstance(info.value.__context__, AuxiliaryModelFloorRefused)
+

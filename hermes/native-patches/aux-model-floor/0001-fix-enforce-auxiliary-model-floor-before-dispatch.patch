+def _floor_home(tmp_path, monkeypatch, floor):
+    home = tmp_path / "agent-home"
+    home.mkdir(exist_ok=True)
+    (home / "config.yaml").write_text(yaml.safe_dump({"auxiliary": {"gpt_model_floor": floor}}), encoding="utf-8")
+    monkeypatch.setenv("HERMES_HOME", str(home))
+
+
+def _summary_agent(model):
+    from run_agent import AIAgent
+    agent = AIAgent(api_key="test-key", base_url="https://openrouter.ai/api/v1", model=model, quiet_mode=True,
+                    skip_context_files=True, skip_memory=True, enabled_toolsets=[])
+    agent.api_mode = "chat_completions"
+    agent._cached_system_prompt = "You are helpful."
+    done = SimpleNamespace(choices=[SimpleNamespace(message=SimpleNamespace(content="Real summary.", tool_calls=None),
+                                                    finish_reason="stop")],
+                           usage=SimpleNamespace(completion_tokens=3), model="m")
+    agent.client.chat.completions.create.side_effect = lambda **kw: done
+    return agent
+

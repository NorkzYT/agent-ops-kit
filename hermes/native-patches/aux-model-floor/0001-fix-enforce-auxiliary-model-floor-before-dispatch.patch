+# Candidates the opt-in model floor refused at dispatch during the current provider-fallback walk,
+# by chain label (``fallback_chain[i](p)`` / ``fallback_providers[i](p)``, unique per entry) and by
+# the model the candidate was dispatched with: the ordered re-walk skips them even when the entry's
+# configured model differs from its resolved one (or is absent), so later entries stay reachable.
+_FLOOR_SKIPPED_IN_WALK: contextvars.ContextVar[Optional[set]] = contextvars.ContextVar(
+    "aux_floor_skipped_in_walk", default=None)
+
+
+def _floor_skips(model: Any, label: Optional[str] = None) -> bool:
+    """Selection filter: the floor refuses ``model``, or refused this entry/model at dispatch in this walk."""
+    skipped = _FLOOR_SKIPPED_IN_WALK.get()
+    if skipped is not None and (model in skipped or (label is not None and ("label", label) in skipped)):
+        return True
+    return _floor_refuses(model)
+
+
+def _skip_floor_refused_candidate(task: Optional[str], fb_label: str, err: Exception, fb_model: Any) -> None:
+    """A fallback candidate the opt-in model floor refused at dispatch: skip it for THIS walk only.
+    Not quarantined (the provider is healthy; another task/model on it may be eligible) and never
+    re-sent; the walk moves on, and on exhaustion the caller raises the primary error."""
+    skipped = _FLOOR_SKIPPED_IN_WALK.get()
+    if skipped is not None:
+        skipped.add(fb_model)
+        skipped.add(("label", fb_label))
+    logger.warning("Auxiliary %s: fallback candidate %s refused by the model floor (%s) — skipping",
+                   task or "call", fb_label, err)
+

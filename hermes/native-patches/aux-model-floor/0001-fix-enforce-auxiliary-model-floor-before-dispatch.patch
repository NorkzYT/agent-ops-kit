+# ── codex app-server runtime (subprocess dispatch, no Hermes provider request) ───────────
+
+
+@pytest.fixture
+def codex_app_server(monkeypatch):
+    """Replaces only the codex subprocess: records each spawn (session construction) and each
+    ``turn/start`` model, then fails the turn so nothing else runs."""
+    from agent.transports import codex_app_server_session as sess_mod
+    calls: list = []
+
+    class _Session:
+        def __init__(self, **kw):
+            calls.append(("spawn", kw.get("model")))
+
+        def ensure_started(self):
+            return "thread-1"
+
+        def run_turn(self, **kw):
+            calls.append(("turn", kw.get("model")))
+            raise RuntimeError("stop after turn/start")
+
+        def close(self):
+            pass
+    monkeypatch.setattr(sess_mod, "CodexAppServerSession", _Session)
+    return calls
+
+
+def _codex_agent(model):
+    from run_agent import AIAgent
+    agent = AIAgent(model=model, provider="openai-codex", api_key="test-key",
+                    base_url="https://chatgpt.com/backend-api/codex", api_mode="codex_app_server",
+                    quiet_mode=True, skip_memory=True, skip_context_files=True, enabled_toolsets=["skills"],
+                    max_iterations=2)
+    assert agent.api_mode == "codex_app_server"
+    return agent
+
+
+@pytest.mark.parametrize("model,floor,sent", [
+    ("gpt-5.5", True, None), ("openai/gpt-5.5", True, None), ("gpt-6.1-luna", True, None),
+    ("gpt-6.1-terra", True, "gpt-6.1-terra"), ("openai/gpt-6.2-sol", True, "gpt-6.2-sol"),
+    ("gpt-5.5", False, "gpt-5.5"),
+])
+def test_scoped_codex_app_server_turn_checks_wire_model_before_spawn(
+        tmp_path, monkeypatch, codex_app_server, model, floor, sent):
+    from agent.aux_model_floor import floor_scope
+    _floor_home(tmp_path, monkeypatch, floor)
+    agent = _codex_agent(model)
+    with floor_scope("curator"):
+        result = agent.run_conversation(user_message="curate")
+    if sent is None:
+        assert codex_app_server == []  # no subprocess, no turn/start
+        assert result.get("model_floor_refused") is True
+        assert "curator:codex_app_server" in str(result.get("error"))
+    else:
+        assert codex_app_server == [("spawn", sent), ("turn", sent)]
+        assert not result.get("model_floor_refused")
+

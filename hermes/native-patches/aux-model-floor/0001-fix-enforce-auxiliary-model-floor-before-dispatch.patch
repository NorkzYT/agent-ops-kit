+# ── configured fallback entry without ``model`` = the provider's default ─────────────────
+
+
+def _provider_default(monkeypatch, default):
+    """The entry names no model, so the route serves its provider default (``default``): resolved
+    by the real ``resolve_provider_client`` against the local endpoint, dispatched for real."""
+    from agent import auxiliary_client as ac
+    real = ac._resolve_fallback_entry
+
+    def resolve(entry):
+        if not str(entry.get("model") or "").strip():
+            return real({**entry, "model": default})
+        return real(entry)
+    monkeypatch.setattr(ac, "_resolve_fallback_entry", resolve)
+
+
+@pytest.mark.parametrize("asynchronous", [False, True])
+@pytest.mark.parametrize("default", ["gpt-6.1-terra", "qwen3:8b"])
+def test_modelless_fallback_entry_serves_eligible_provider_default(profile, monkeypatch, asynchronous, default):
+    configure, requests, _ = profile
+    configure(floor=True, model="no-credit", fallback=[None])
+    _provider_default(monkeypatch, default)
+    _acall() if asynchronous else _call()
+    assert [p["model"] for _, p in requests] == ["no-credit", default]
+
+

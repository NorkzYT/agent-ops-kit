+def test_scoped_codex_app_server_rechecks_exact_turn_model(tmp_path, monkeypatch, codex_app_server):
+    """A kept session whose recorded provider differs: the exact ``turn/start`` id is re-checked."""
+    from agent import codex_runtime
+    from agent.aux_model_floor import floor_scope
+    _floor_home(tmp_path, monkeypatch, True)
+    agent = _codex_agent("gpt-6.1-terra")
+    real = codex_runtime._codex_wire_model
+    monkeypatch.setattr(codex_runtime, "_codex_wire_model",
+                        lambda a, mp: real(a, mp) if mp is None else "gpt-4o")
+    monkeypatch.setattr(codex_runtime, "_codex_model_provider", lambda a: None)
+    with floor_scope("curator"):
+        codex_runtime._ensure_codex_session(agent, [])
+        # attached without a recorded composition: kept as-is, so its provider id drives turn/start
+        agent._codex_session_prompt, agent._codex_session_model_provider = None, "kept-provider"
+        result = agent.run_conversation(user_message="curate")
+    assert codex_app_server == [("spawn", "gpt-6.1-terra")]  # pre-spawn check passed; turn/start never sent
+    assert result.get("model_floor_refused") is True

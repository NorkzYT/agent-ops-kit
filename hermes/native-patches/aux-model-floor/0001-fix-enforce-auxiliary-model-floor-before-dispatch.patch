+@pytest.fixture
+def profile(tmp_path, monkeypatch, endpoint):
+    base_url, requests = endpoint
+    monkeypatch.setenv("HERMES_HOME", str(tmp_path / "home"))
+
+    def _configure(**kw):
+        _write_profile(tmp_path / "home", base_url, **kw)
+        from agent.auxiliary_client import _reset_aux_unhealthy_cache, shutdown_cached_clients
+        shutdown_cached_clients()
+        _reset_aux_unhealthy_cache()
+    return _configure, requests, base_url
+
